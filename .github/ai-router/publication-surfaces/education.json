{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "education",
  "description": "Existing Diamond Gate Bridge Education module at /products/education/: layered standards carousel plus the English adaptive-placement demo flow.",
  "checks": [
    {
      "path": "/products/education/index.html",
      "includes": [
        "EDUCATION_COHERISCOPE_PATTERN_PLACEMENT_DEMO_v1",
        "English Fluency Accelerator",
        "Start where your ability actually is.",
        "Six standards. One learning system.",
        "Foundation",
        "Productive Language",
        "Progression",
        "Support",
        "Placement",
        "Evidence",
        "Reading",
        "Engineering",
        "Evidence standing",
        "Return to Carousel",
        "Start the Demo",
        "NATIVE_SUPPORTED",
        "BILINGUAL_BRIDGED",
        "TARGET_DOMINANT",
        "TARGET_ONLY",
        "ABOVE_PHASE_1",
        "demo_entry_point",
        "data-no-backend=\"true\"",
        "data-no-persistence=\"true\""
      ],
      "excludes": [
        "Public Face",
        "Technical Face",
        "data-demo-language-spanish=\"available\"",
        "data-demo-language-chinese=\"available\"",
        "data-speech-measurement=\"true\"",
        "data-listening-measurement=\"true\""
      ]
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/products/education/",
    "timeoutMs": 15000,
    "readySelector": "html[data-education-demo-ready=\"true\"]",
    "binding": {
      "mode": "direct-document",
      "path": "/products/education/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [],
    "interactions": [
      {
        "name": "Outer carousel advances to Productive Language",
        "action": {
          "type": "click",
          "selector": "[data-edu-index=\"1\"]"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "[data-edu-live]",
            "value": "Productive Language"
          },
          {
            "type": "textContains",
            "selector": ".edu-standard-card[data-active=\"true\"] .edu-standard-title",
            "value": "Build More Than You Memorize"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Selected standard opens in shared carousel field",
        "action": {
          "type": "click",
          "selector": ".edu-standard-card[data-active=\"true\"] [data-edu-inspect]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "[data-edu-carousel]",
            "name": "data-inspecting",
            "value": "true"
          },
          {
            "type": "exists",
            "selector": ".edu-standard-card[data-active=\"true\"][data-inspecting=\"true\"]"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Engineering lens changes independently",
        "action": {
          "type": "click",
          "selector": ".edu-standard-card[data-active=\"true\"] [data-edu-lens=\"engineering\"]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": ".edu-standard-card[data-active=\"true\"] [data-edu-lens=\"engineering\"]",
            "name": "aria-selected",
            "value": "true"
          },
          {
            "type": "textContains",
            "selector": ".edu-standard-card[data-active=\"true\"] [data-edu-cell]",
            "value": "Engineering detail"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Return to carousel preserves selected outer standard",
        "action": {
          "type": "click",
          "selector": ".edu-standard-card[data-active=\"true\"] [data-edu-return]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "[data-edu-carousel]",
            "name": "data-inspecting",
            "value": "false"
          },
          {
            "type": "textContains",
            "selector": "[data-edu-live]",
            "value": "Productive Language"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Start Demo opens language selection",
        "action": {
          "type": "click",
          "selector": "[data-start-demo]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#demo-shell:not([hidden])"
          },
          {
            "type": "textContains",
            "selector": "#demo-title",
            "value": "Choose a language"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "English enters learner intake on same live module",
        "action": {
          "type": "click",
          "selector": "[data-language=\"English\"]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "[data-demo-stage=\"intake\"]:not([hidden])"
          },
          {
            "type": "textContains",
            "selector": "[data-demo-stage=\"intake\"]",
            "value": "Tell us where you think you are."
          }
        ],
        "timeoutMs": 5000
      }
    ]
  }
}

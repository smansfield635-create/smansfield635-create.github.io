{
  "schema": "REFERENCE_CLASS_AWARDS_ADMISSION_DECISION_BOUNDARY_v1",
  "status": "FROZEN_FOR_CALIBRATION_NOT_ACTIVE",
  "allowedDispositions": [
    "AWARDS_CONVERSATION_ADMISSIBLE",
    "BELOW_AWARDS_CONVERSATION",
    "UNEVALUABLE"
  ],
  "evaluationOrder": [
    "VERIFY_EXACT_CANDIDATE_AND_REFERENCE_IDENTITIES",
    "VERIFY_REQUIRED_RENDERED_AND_INTERACTION_EVIDENCE",
    "TEST_CATASTROPHIC_FAILURES",
    "JUDGE_RENDERED_WHOLE_AGAINST_RELEVANT_REFERENCE_CLASS_MATURITY",
    "EMIT_ONE_FAIL_CLOSED_DISPOSITION"
  ],
  "rules": [
    {
      "id": "EVIDENCE_OR_IDENTITY_INCOMPLETE",
      "when": "ANY_REQUIRED_EVIDENCE_OR_EXACT_REFERENCE_IDENTITY_IS_MISSING_AMBIGUOUS_OR_MOVING",
      "result": "UNEVALUABLE"
    },
    {
      "id": "CATASTROPHIC_FAILURE_PRESENT",
      "when": "ANY_CATASTROPHIC_FAILURE_CLASS_IS_ESTABLISHED",
      "result": "BELOW_AWARDS_CONVERSATION"
    },
    {
      "id": "REFERENCE_MATURITY_NOT_REACHED",
      "when": "THE_RENDERED_WHOLE_DOES_NOT_PLAUSIBLY_BELONG_IN_THE_SAME_PROFESSIONAL_MATURITY_CONVERSATION_AS_THE_RELEVANT_REFERENCE_CLASS",
      "result": "BELOW_AWARDS_CONVERSATION"
    },
    {
      "id": "REFERENCE_MATURITY_REACHED",
      "when": "EVIDENCE_IS_COMPLETE_NO_CATASTROPHIC_FAILURE_EXISTS_AND_THE_RENDERED_WHOLE_PLAUSIBLY_BELONGS_IN_THE_SAME_PROFESSIONAL_MATURITY_CONVERSATION_AS_THE_RELEVANT_REFERENCE_CLASS",
      "result": "AWARDS_CONVERSATION_ADMISSIBLE"
    }
  ],
  "noncompensation": {
    "enabled": true,
    "weightedTotalCanOverrideCatastrophicFailure": false,
    "highTechnicalScoreCanOverridePerceptualCollapse": false,
    "highAccessibilityScoreCanOverridePerceptualCollapse": false,
    "highPerformanceScoreCanOverridePerceptualCollapse": false,
    "featureCountCanOverridePerceptualCollapse": false
  },
  "wholeArtifactTests": [
    "WHOLE_BEFORE_PARTS",
    "MEANINGFUL_END_TO_END_USE",
    "PURPOSE_FORM_INTEGRATION",
    "PERCEPTUAL_AND_SPATIAL_COHERENCE",
    "AUTHORSHIP_AND_FINISH",
    "REFERENCE_CLASS_MATURITY_CONFRONTATION"
  ],
  "explicitProhibitions": [
    "PASS_FROM_DRAG_PINCH_ZOOM_OR_WEBGL_PRESENCE_ALONE",
    "PASS_FROM_ATOMIC_FEATURE_INVENTORY",
    "PASS_FROM_STYLE_SIMILARITY_TO_REFERENCE",
    "FAIL_FROM_STYLE_DIFFERENCE_ALONE",
    "PASS_FROM_EXPLANATION_OF_ENGINEERING_COMPLEXITY_NOT_VISIBLE_IN_THE_EXPERIENCE",
    "AWARD_WIN_OR_NAMED_AWARD_READINESS_CLAIM"
  ]
}

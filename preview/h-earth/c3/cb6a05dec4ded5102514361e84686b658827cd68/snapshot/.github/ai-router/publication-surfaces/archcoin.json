{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "archcoin",
  "description": "ARCHCOIN exact-head publication verification for the four-domain carousel presentation: ARCC and ARCR launched on Ethereum mainnet, with ARCP and ARCA prospective and not launched. Static checks bind verified mainnet identities, supply, decimals, and explorer links, preserve sixteen semantic planes and sixteen legacy deep links, and retain token-rights boundaries. Runtime verification requires the ARCC carousel to initialize and proves click plus keyboard traversal before publication is accepted.",
  "checks": [
    {
      "path": "/products/archcoin/index.html",
      "includes": [
        "Each token page presents its Overview, Engineering, Platform, and Governance.",
        "/products/archcoin/contract/#overview",
        "/products/archcoin/receivable/#engineering",
        "/products/archcoin/payable/#platform",
        "/products/archcoin/allocation/#governance",
        "Two tokens launched. Two prospective.",
        "Ethereum mainnet"
      ],
      "excludes": [
        "domain then opens four navigable rooms"
      ]
    },
    {
      "path": "/products/archcoin/index.controller.js",
      "includes": [
        "route: \"/products/archcoin/contract/#overview\"",
        "route: \"/products/archcoin/receivable/#engineering\"",
        "route: \"/products/archcoin/payable/#platform\"",
        "route: \"/products/archcoin/allocation/#governance\"",
        "ROOM_BY_ROUTE.size === 16"
      ],
      "excludes": [
        "route: \"/products/archcoin/contract/overview/\""
      ]
    },
    {
      "path": "/products/archcoin/contract/index.html",
      "includes": [
        "data-domain=\"contract\"",
        "ARCHCOIN Contract",
        "ARCC",
        "data-archcoin-carousel",
        "ERC-20 behavior",
        "No post-deployment mint",
        "Launch status",
        "Ethereum mainnet · Launched",

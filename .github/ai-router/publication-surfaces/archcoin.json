      "excludes": []
    },
    {
      "path": "/products/archcoin/allocation/engineering/index.html",
      "includes": ["rel=\"canonical\" href=\"../#engineering\"", "content=\"0; url=../#engineering\""],
      "excludes": []
    },
    {
      "path": "/products/archcoin/allocation/platform/index.html",
      "includes": ["rel=\"canonical\" href=\"../#platform\"", "content=\"0; url=../#platform\""],
      "excludes": []
    },
    {
      "path": "/products/archcoin/allocation/governance/index.html",
      "includes": ["rel=\"canonical\" href=\"../#governance\"", "content=\"0; url=../#governance\""],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/products/archcoin/contract/",
    "timeoutMs": 15000,
    "readySelector": "[data-archcoin-carousel][data-carousel-ready=\"true\"]",
    "binding": {
      "mode": "direct-document",
      "path": "/products/archcoin/contract/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [],
    "interactions": [
      {
        "name": "Open engineering plane",
        "action": {"type": "click", "selector": "#tab-engineering"},
        "assertions": [
          {"type": "attributeEquals", "selector": "#tab-engineering", "name": "aria-selected", "value": "true"},
          {"type": "attributeEquals", "selector": "[data-archcoin-carousel]", "name": "data-active-plane", "value": "engineering"},
          {"type": "attributeEquals", "selector": "#plane-engineering", "name": "aria-hidden", "value": "false"}
        ]
      },
      {
        "name": "Traverse to governance with keyboard",
        "action": {"type": "key", "selector": "#tab-engineering", "key": "End"},
        "assertions": [
          {"type": "attributeEquals", "selector": "#tab-governance", "name": "aria-selected", "value": "true"},
          {"type": "attributeEquals", "selector": "[data-archcoin-carousel]", "name": "data-active-plane", "value": "governance"},
          {"type": "textContains", "selector": "#plane-governance", "value": "No post-deployment mint"}
        ]
      },
      {
        "name": "Return to overview",
        "action": {"type": "click", "selector": "#tab-overview"},
        "assertions": [
          {"type": "attributeEquals", "selector": "#tab-overview", "name": "aria-selected", "value": "true"},
          {"type": "attributeEquals", "selector": "[data-archcoin-carousel]", "name": "data-active-plane", "value": "overview"}
        ]
      }
    ]
  }
}

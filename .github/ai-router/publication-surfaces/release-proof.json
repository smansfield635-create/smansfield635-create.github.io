{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "release-proof",
  "description": "Single NIST plate case with alternate HOLD entry, selectable 38-characteristic evidence matrix and preserved shipping boundary.",
  "checks": [
    {
      "path": "/release-proof/index.html",
      "includes": [
        "Release Proof — Mission Control",
        "id=\"create-button\"",
        "id=\"next-action\"",
        "READY_UNDER_SUPPLIED_RECORDS",
        "NOT_ESTABLISHED",
        "id=\"inspection-canvas\"",
        "id=\"outcome-spotlight\"",
        "HISTORICAL REPLAY · GUIDED DEMONSTRATION",
        "id=\"toggle-orders\"",
        "id=\"creation-mode\"",
        "WHAT IS THE PART?",
        "OPEN THIS ORDER",
        "Markers 8 and 11",
        "id=\"start-hold\"",
        "38-check matrix",
        "class=\"evidence-matrix\"",
        "data-check-id",
        "DEMO_SHORTCUT_TO_HOLD"
      ],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/release-proof/",
    "timeoutMs": 15000,
    "binding": {
      "mode": "direct-document",
      "path": "/release-proof/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [],
    "interactions": [
      {
        "name": "Tablet order switcher expands",
        "action": {
          "type": "click",
          "selector": "#toggle-orders"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "#toggle-orders",
            "name": "aria-expanded",
            "value": "true"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Guided order advances",
        "action": {
          "type": "click",
          "selector": "#next-action"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#step-counter",
            "value": "1 / 7"
          }
        ],
        "timeoutMs": 10000
      },
      {
        "name": "Historical journey checkpoint 2",
        "action": {
          "type": "click",
          "selector": "#next-action"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#step-counter",
            "value": "2 / 7"
          },
          {
            "type": "textContains",
            "selector": "#shipping-status",
            "value": "NOT AUTHORIZED"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Historical journey checkpoint 3",
        "action": {
          "type": "click",
          "selector": "#next-action"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#step-counter",
            "value": "3 / 7"
          },
          {
            "type": "textContains",
            "selector": "#shipping-status",
            "value": "NOT AUTHORIZED"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Historical journey checkpoint 4",
        "action": {
          "type": "click",
          "selector": "#next-action"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#step-counter",
            "value": "4 / 7"
          },
          {
            "type": "textContains",
            "selector": "#shipping-status",
            "value": "NOT AUTHORIZED"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Historical journey checkpoint 5",
        "action": {
          "type": "click",
          "selector": "#next-action"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#step-counter",
            "value": "5 / 7"
          },
          {
            "type": "textContains",
            "selector": "#shipping-status",
            "value": "NOT AUTHORIZED"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Historical journey checkpoint 6",
        "action": {
          "type": "click",
          "selector": "#next-action"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#step-counter",
            "value": "6 / 7"
          },
          {
            "type": "textContains",
            "selector": "#shipping-status",
            "value": "NOT AUTHORIZED"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Historical journey checkpoint 7",
        "action": {
          "type": "click",
          "selector": "#next-action"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#step-counter",
            "value": "7 / 7"
          },
          {
            "type": "textContains",
            "selector": "#shipping-status",
            "value": "NOT AUTHORIZED"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Completed replay shows 36 2 38",
        "action": {
          "type": "click",
          "selector": "[data-tab='decision']"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#outcome-retained",
            "value": "36"
          },
          {
            "type": "textContains",
            "selector": "#outcome-renewed",
            "value": "2"
          },
          {
            "type": "textContains",
            "selector": "#outcome-total",
            "value": "38/38"
          },
          {
            "type": "textContains",
            "selector": "#outcome-spotlight",
            "value": "Historical scenario replay"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Live local planning workbench opens",
        "action": {
          "type": "click",
          "selector": "[data-tab='plan']"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#planner-details",
            "value": "Live schedule calculation"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Planner details expand",
        "action": {
          "type": "click",
          "selector": "#planner-details summary"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#run-planner"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Live schedule calculation checks",
        "action": {
          "type": "click",
          "selector": "#run-planner"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#planner-result",
            "value": "PASS"
          }
        ],
        "timeoutMs": 10000
      },
      {
        "name": "3D inspection is accessible",
        "action": {
          "type": "click",
          "selector": "[data-tab='inspection']"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#inspection-canvas"
          }
        ],
        "timeoutMs": 8000
      },
      {
        "name": "Open evidence matrix",
        "action": {
          "type": "click",
          "selector": "[data-tab='evidence']"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": ".evidence-matrix [data-check-id='8']"
          },
          {
            "type": "exists",
            "selector": ".evidence-matrix [data-check-id='11']"
          },
          {
            "type": "exists",
            "selector": ".evidence-tile.renewed"
          },
          {
            "type": "exists",
            "selector": "#evidence-detail"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Inspect check 11 and revision lineage",
        "action": {
          "type": "click",
          "selector": "[data-check-id='11']"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#evidence-detail",
            "value": "Perpendicularity 1"
          },
          {
            "type": "textContains",
            "selector": "#evidence-detail",
            "value": "Revision B"
          },
          {
            "type": "attributeEquals",
            "selector": "[data-check-id='11']",
            "name": "aria-pressed",
            "value": "true"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Locate selected check in 3D",
        "action": {
          "type": "click",
          "selector": "#see-on-3d"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#inspection-canvas"
          },
          {
            "type": "textContains",
            "selector": ".feature-info",
            "value": "SELECTED CHARACTERISTIC 11"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Return from 3D to matrix",
        "action": {
          "type": "click",
          "selector": "#inspect-in-matrix"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": ".evidence-matrix"
          },
          {
            "type": "attributeEquals",
            "selector": "[data-check-id='11']",
            "name": "aria-pressed",
            "value": "true"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Restart unified NIST example",
        "action": {
          "type": "click",
          "selector": "#start-beginning"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#step-counter",
            "value": "0 / 7"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Jump to revision B HOLD inside same case",
        "action": {
          "type": "click",
          "selector": "#start-hold"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#step-counter",
            "value": "3 / 7"
          },
          {
            "type": "textContains",
            "selector": "#decision-status",
            "value": "HOLD"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Show exactly affected checks in matrix",
        "action": {
          "type": "click",
          "selector": "[data-tab='evidence']"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "[data-check-id='8'].needs-renewal"
          },
          {
            "type": "exists",
            "selector": "[data-check-id='11'].needs-renewal"
          },
          {
            "type": "exists",
            "selector": ".technical-records"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Guided creation still accessible",
        "action": {
          "type": "click",
          "selector": "#create-button"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#create-dialog[open]"
          },
          {
            "type": "textContains",
            "selector": "#create-dialog",
            "value": "Guided: NIST inspection case"
          },
          {
            "type": "textContains",
            "selector": "#create-dialog",
            "value": "At revision B HOLD"
          }
        ],
        "timeoutMs": 5000
      }
    ]
  }
}

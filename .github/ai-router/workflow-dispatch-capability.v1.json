    "freshRequestBranchFromCurrentMainRequired": true,
    "requestCommitParentMustEqualCurrentMain": true,
    "dispatchRunIdMustBeRecovered": true,
    "receiptMustBindRequestCommitMainHeadWorkflowRefInputsAndRunId": true,
    "receiptResult": "NATIVE_WORKFLOW_DISPATCH_ACCEPTED_AND_RUN_RESOLVED",
    "directConnectorDispatchPreferredWhenAvailable": true,
    "fallbackMayNotCreateGenericCommandAuthority": true,
    "transportPullRequestIsExecutionCarrierOnly": true,
    "transportPullRequestMayNeverBeMerged": true,
    "successfulTransportLeavesNoRequestBranch": true,
    "failedCarrierMustBeLocalizedBeforeReplacement": true,
    "serialEquivalentCarrierRetriesAllowed": false

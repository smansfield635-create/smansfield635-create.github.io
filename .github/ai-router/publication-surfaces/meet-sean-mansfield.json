{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "meet-sean-mansfield",
  "description": "Compact speaking topic carousel with on-demand adult/youth agenda inspector; inquiry preparation preserves pending email activation.",
  "checks": [
    {
      "path": "/meet-sean-mansfield/index.html",
      "includes": [
        "The person",
        "sean-portrait.webp",
        "/assets/dgb-estate-cosmos.js",
        "data-delivery-status=\"pending-verification\"",
        "mailto:hello@diamondgatebridge.com",
        "Online sending unavailable",
        "type=\"date\""
      ],
      "excludes": [
        "requests are not sent from this preview"
      ]
    },
    {
      "path": "/meet-sean-mansfield/profile.css",
      "includes": [
        ".portrait",
        "@media"
      ],
      "excludes": []
    },
    {
      "path": "/meet-sean-mansfield/speaking.js",
      "includes": [
        "https://formsubmit.co/ajax/hello@diamondgatebridge.com",
        "if(!verified)"
      ],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/meet-sean-mansfield/",
    "timeoutMs": 15000,
    "readySelector": "#review-button:not([disabled])",
    "binding": {
      "mode": "direct-document",
      "path": "/meet-sean-mansfield/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [
      "favicon.ico"
    ],
    "interactions": [
      {
        "name": "Choose an inspectable topic",
        "action": {
          "type": "click",
          "selector": "[data-talk-index=\"2\"]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": ".topic-slide[data-active=\"true\"] [data-topic=\"The Inner Underdog\"]"
          }
        ]
      },
      {
        "name": "Open the selected agenda",
        "action": {
          "type": "click",
          "selector": ".topic-slide[data-active=\"true\"] summary"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#agenda-inspector[open]"
          },
          {
            "type": "textContains",
            "selector": "#inspector-title",
            "value": "The Inner Underdog"
          }
        ]
      },
      {
        "name": "Inspect the youth agenda",
        "action": {
          "type": "click",
          "selector": "#agenda-inspector [data-agenda-side=\"youth\"]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#agenda-inspector [data-face=\"youth\"][aria-hidden=\"false\"]"
          }
        ]
      },
      {
        "name": "Carry inspected audience into inquiry",
        "action": {
          "type": "click",
          "selector": "#agenda-inspector [data-topic=\"The Inner Underdog\"]"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#topic option:checked",
            "value": "The Inner Underdog"
          },
          {
            "type": "textContains",
            "selector": "#audience option:checked",
            "value": "Schools & youth"
          },
          {
            "type": "exists",
            "selector": "#send-button[disabled]"
          }
        ]
      }
    ]
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "REFERENCE_CLASS_AWARDS_ADMISSION_EVIDENCE_BUNDLE_v1",
  "title": "Reference-Class Awards Admission Evidence Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","candidate","reference","pageExcellence","applicableDevices","renderedEvidence","interactionTrace","technicalContext","evidenceDigest"],
  "properties": {
    "schema": {"const":"REFERENCE_CLASS_AWARDS_ADMISSION_EVIDENCE_BUNDLE_v1"},
    "candidate": {
      "type":"object","additionalProperties":false,
      "required":["candidateId","commitSha","manifestationClass"],
      "properties": {
        "candidateId":{"type":"string","minLength":1},
        "commitSha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
        "manifestationClass":{"enum":["SPATIAL_INSTRUMENT_AND_NAVIGATION_MODEL","LIVE_ENVIRONMENTAL_INTERACTIVE_EXPERIENCE","THREE_DIMENSIONAL_PLANETARY_GLOBE_AND_WORLD_SYSTEM"]}
      }
    },
    "reference": {
      "type":"object","additionalProperties":false,
      "required":["referenceId","commitSha"],
      "properties": {
        "referenceId":{"type":"string","minLength":1},
        "commitSha":{"type":"string","pattern":"^[0-9a-f]{40}$"}
      }
    },
    "pageExcellence": {
      "type":"object","additionalProperties":false,
      "required":["result","receiptDigest"],
      "properties": {
        "result":{"enum":["PASS","FAIL","UNEVALUABLE"]},
        "receiptDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    },
    "applicableDevices": {
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"enum":["PHONE","TABLET","DESKTOP"]}
    },
    "renderedEvidence": {
      "type":"array","minItems":3,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["artifactId","kind","stateClass","deviceClass","sha256"],
        "properties": {
          "artifactId":{"type":"string","minLength":1},
          "kind":{"enum":["SCREENSHOT","VIDEO"]},
          "stateClass":{"enum":["INITIAL_RENDERED_STATE","MEANINGFUL_INTERACTION_STATE","RESULT_OR_NAVIGATION_STATE"]},
          "deviceClass":{"enum":["PHONE","TABLET","DESKTOP"]},
          "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
        }
      }
    },
    "interactionTrace": {
      "type":"object","additionalProperties":false,
      "required":["required","meaningfulConsequenceObserved","traceDigest"],
      "properties": {
        "required":{"type":"boolean"},
        "meaningfulConsequenceObserved":{"type":"boolean"},
        "traceDigest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    },
    "technicalContext": {
      "type":"object","additionalProperties":true,
      "description":"Context only. These values may never create or rescue an admission decision."
    },
    "evidenceDigest": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}

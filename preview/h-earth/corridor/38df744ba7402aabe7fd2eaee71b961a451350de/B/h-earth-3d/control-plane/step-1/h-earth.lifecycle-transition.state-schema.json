{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smansfield635-create.github.io/h-earth-3d/control-plane/step-1/h-earth.lifecycle-transition.state-schema.json",
  "title": "H-Earth Repository Lifecycle State Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stateId",
    "artifactId",
    "state",
    "accepted",
    "active",
    "canonical",
    "executableAuthority",
    "historicalProvenancePreserved",
    "controllingCommit",
    "identityEvidence"
  ],
  "properties": {
    "stateId": {
      "type": "string",
      "minLength": 1
    },
    "artifactId": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "CANDIDATE",
        "VALIDATED",
        "ACCEPTED",
        "ACTIVE",
        "SUPERSEDED",
        "RETIRED"
      ]
    },
    "accepted": {
      "type": "boolean"
    },
    "active": {
      "type": "boolean"
    },
    "canonical": {
      "type": "boolean"
    },
    "executableAuthority": {
      "enum": [
        "NONE",
        "WITHHELD",
        "ACTIVE",
        "WITHDRAWN",
        "RETIRED"
      ]
    },
    "historicalProvenancePreserved": {
      "const": true
    },
    "controllingCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "identityEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceReference"
      }
    },
    "supersedesArtifactId": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersededByArtifactId": {
      "type": [
        "string",
        "null"
      ]
    },
    "retirementReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "unresolvedFields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "gitBlobSha"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "gitBlobSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "x-h-earth-boundaries": {
    "schemaCreatesAcceptance": false,
    "schemaCreatesActivationAuthority": false,
    "schemaCreatesCanonicalizationAuthority": false,
    "schemaCreatesMutationAuthority": false
  }
}

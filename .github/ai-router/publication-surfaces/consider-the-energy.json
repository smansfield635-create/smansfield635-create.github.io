{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "consider-the-energy",
  "description": "Consider the Energy Community page exact-head publication verification for the Generation 2236 dual-backend four-season lifecycle successor and shared estate cosmic background. Static checks bind the fresh lifecycle consumer identity, WebGL2/GLSL ES 3.00 plus WebGL1/GLSL ES 1.00 source contract, cycle-local shader time, precision diagnostics, bounded visible-frame proof, and recoverable context restoration. Generic headless runtime verifies only the environment-independent shared decorative canvas and error-free page load; it does not establish physical-device lifecycle GPU visible-frame, backend, precision, or context-restoration acceptance. Physical-device lifecycle acceptance occurs only after exact-head publication and live source verification.",
  "checks": [
    {
      "path": "/campaigns/consider-the-energy/index.html",
      "includes": [
        "data-route=\"/campaigns/consider-the-energy/\"",
        "data-community-lifecycle-mount></figure>",
        "/assets/dgb-estate-cosmos.js",
        "/campaigns/consider-the-energy/community-lifecycle3d.js?v=20260914-one-shot-environment-v1",
        "Consider the Community with Consider the Energy."
      ],
      "excludes": [
        "data-community-lifecycle-fallback",
        "community-lifecycle3d.js?v=20260914-stage-final"
      ]
    },
    {
      "path": "/campaigns/consider-the-energy/community-lifecycle3d.js",
      "includes": [
        "DGB_COMMUNITY_LIFECYCLE_TREE_4SEASON_GEOMETRY_v1",
        "COMMUNITY_FOUR_SEASON_LIFECYCLE_SCULPTURE",
        "SEED','ROOTS','NETWORK','GROWTH','TREE_LOCK','SETTLEMENT','CONTRIBUTION','RENEWAL",
        "SPRING','SUMMER','AUTUMN','WINTER",
        "b5289094db8648800197a03226d6322902960b48",
        "lifecycleMode: 'ONE_SHOT_INTRO_THEN_MATURE_LOCK'",
        "environment: 'LOCAL_HERO_POST_LOCK'",
        "environmentCycleSeconds: 72",
        "treeCycleComplete:treeState==='TREE_MATURE_LOCK'",
        "environmentActive:environmentPhase!=='INACTIVE'",
        "function precisionProfile(gl)",
        "gl.getShaderPrecisionFormat",
        "#version 300 es",
        "shaderLanguage:'GLSL ES 3.00'",
        "shaderLanguage:'GLSL ES 1.00'",
        "function cycleTimeSeconds(ms)",
        "gl.uniform1f(R.u.time,cycleTimeSeconds(elapsed))",
        "function visiblePixelProof(gl,canvas)",
        "visible-frame-proof-failed",
        "webglcontextlost",
        "recoverable:true",
        "webglcontextrestored",
        "contextRestoreCount",
        "backendAttempts",
        "visibleFrameProof",
        "host.dataset.lifecycleReady='true';host.dataset.lifecycleStatus='ready'",
        "seasonCount:4",
        "fallbackPreserved:false,fallbackRemoved:true",
        "queueMicrotask(() => mount(root))"
      ],
      "excludes": [
        "gl.uniform1f(R.u.time,now)",
        "gl.getExtension('WEBGL_lose_context')",
        "webglContexts:1,webglVersion:1",
        "host.dataset.lifecycleFallback='webgl-unavailable'",
        "fallbackPreserved:!!fallback",
        "if (root) mount(root);"
      ]
    },
    {
      "path": "/assets/dgb-estate-cosmos.js",
      "includes": [
        "DGB_ESTATE_COSMIC_CONTINUITY_v1",
        "pointerEvents: \"none\"",
        "mobileDprCap: 1",
        "desktopDprCap: 1.25",
        "visibilitychange",
        "prefers-reduced-motion: reduce"
      ],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/campaigns/consider-the-energy/",
    "timeoutMs": 15000,
    "readySelector": "#dgb-estate-cosmos[data-dgb-estate-cosmos-status=\"available\"]",
    "binding": {
      "mode": "direct-document",
      "path": "/campaigns/consider-the-energy/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": []
  }
}

{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "research-frontier-gen1863",
  "description": "Accepted Research Frontier four-card achievement-amplified dual-face orbital publication contract with direct-document, Scientific, Agentic, shared-bridge, return, claim-boundary, and error proof.",
  "checks": [
    {
      "path": "/evidence/agentic-frontier/",
      "includes": [
        "<title>Research Frontier — Diamond Gate Bridge</title>",
        "data-evidence-field",
        "data-orbit-stage",
        "data-orbit-card",
        "data-reader data-face=\"scientific\"",
        "data-reader-face=\"scientific\"",
        "data-reader-face=\"agentic\"",
        "data-flip-face=\"agentic\"",
        "data-flip-face=\"scientific\"",
        "data-return-orbit",
        "906 pull requests. One audited month.",
        "Clarity tracks contextual relevance to the selected object. It does not imply stronger evidence, greater confidence, or truth.",
        "Scientific Frontier · Object 01 · Equal face 01",
        "Agentic Frontier · Object 01 · Equal face 02",
        "Broad cross-domain generality, independent replication, and a universal law are not claimed.",
        "documented coordination and successful production do not yet prove an efficiency improvement or general causal superiority.",
        "A documented integrity choice: preserve unavailable row-level evidence and contradictions as constraints instead of manufacturing a cleaner result.",
        "External validation, a larger frozen comparative battery, clean-room reproduction, and stronger cross-domain testing."
      ],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/evidence/agentic-frontier/",
    "timeoutMs": 30000,
    "readySelector": "[data-orbit-card]",
    "binding": {
      "mode": "direct-document",
      "path": "/evidence/agentic-frontier/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [
      "Failed to load resource: the server responded with a status of 404 (File not found)",
      "Failed to load resource: the server responded with a status of 404 ()"
    ],
    "interactions": [
      {
        "name": "orbit card opens Scientific reader",
        "action": {"type": "click", "selector": "[data-orbit-card]"},
        "assertions": [
          {"type": "attributeEquals", "selector": "[data-reader]", "name": "data-face", "value": "scientific"},
          {"type": "attributeEquals", "selector": "[data-reader-face=\"scientific\"]", "name": "aria-hidden", "value": "false"},
          {"type": "attributeEquals", "selector": "[data-reader-face=\"agentic\"]", "name": "aria-hidden", "value": "true"},
          {"type": "attributeEquals", "selector": "[data-orbit-stage]", "name": "aria-hidden", "value": "true"},
          {"type": "attributeEquals", "selector": "[data-evidence-field]", "name": "data-inspecting", "value": "true"},
          {"type": "textContains", "selector": "[data-reader-face=\"scientific\"]", "value": "Do viable futures reveal fragility?"}
        ]
      },
      {
        "name": "visible control turns to Agentic face",
        "action": {"type": "click", "selector": "[data-reader-face=\"scientific\"] [data-flip-face=\"agentic\"]"},
        "assertions": [
          {"type": "attributeEquals", "selector": "[data-reader]", "name": "data-face", "value": "agentic"},
          {"type": "attributeEquals", "selector": "[data-reader]", "name": "aria-labelledby", "value": "agentic-title"},
          {"type": "attributeEquals", "selector": "[data-reader-face=\"scientific\"]", "name": "aria-hidden", "value": "true"},
          {"type": "attributeEquals", "selector": "[data-reader-face=\"agentic\"]", "name": "aria-hidden", "value": "false"},
          {"type": "textContains", "selector": "[data-reader-face=\"agentic\"]", "value": "Can agency scale without losing the trail?"}
        ]
      },
      {
        "name": "Agentic keyboard opens observability lens",
        "action": {"type": "key", "selector": "#agentic-tab-coordination", "key": "ArrowRight"},
        "assertions": [
          {"type": "attributeEquals", "selector": "#agentic-tab-observability", "name": "aria-selected", "value": "true"},
          {"type": "attributeEquals", "selector": "#agentic-tab-coordination", "name": "aria-selected", "value": "false"},
          {"type": "textContains", "selector": "#agentic-panel-observability", "value": "FAILURE CAN BE CLASSIFIED BEFORE RESPONSE"},
          {"type": "textContains", "selector": "#agentic-panel-observability", "value": "LIVE VERIFY · Did the visitor receive the intended product?"}
        ]
      },
      {
        "name": "Agentic keyboard return restores orbit",
        "action": {"type": "key", "selector": "[data-reader-face=\"agentic\"] [data-return-orbit]", "key": "Enter"},
        "assertions": [
          {"type": "attributeEquals", "selector": "[data-evidence-field]", "name": "data-inspecting", "value": "false"},
          {"type": "attributeContains", "selector": "[data-orbit-card]", "name": "aria-label", "value": "Agentic face"},
          {"type": "textContains", "selector": "[data-face-preview]", "value": "Agentic retained"}
        ]
      },
      {
        "name": "keyboard reopens retained Agentic face",
        "action": {"type": "key", "selector": "[data-orbit-stage]", "key": "Enter"},
        "assertions": [
          {"type": "attributeEquals", "selector": "[data-reader]", "name": "data-face", "value": "agentic"},
          {"type": "attributeEquals", "selector": "[data-reader-face=\"agentic\"]", "name": "aria-hidden", "value": "false"},
          {"type": "attributeEquals", "selector": "[data-orbit-stage]", "name": "aria-hidden", "value": "true"},
          {"type": "attributeEquals", "selector": "[data-evidence-field]", "name": "data-inspecting", "value": "true"}
        ]
      }
    ]
  }
}

{
  "schema": "DEVELOPMENT_PIPELINE_POLICY_REGISTRY_v1",
  "registryId": "REPOSITORY_DEVELOPMENT_PIPELINE_POLICY_AS_CODE_v1",
  "version": "1.0.0",
  "status": "ACTIVE_FAIL_CLOSED",
  "defaultDecision": "REVIEW_REQUIRED",
  "protectedPathPrefixes": [
    "showroom/",
    "laws/",
    "h-earth-3d/",
    "tests/",
    "products/",
    "validation/"
  ],
  "alwaysDeniedExactPaths": [
    ".github/operation-intake/active-operation-ledger.v1.json"
  ],
  "authorityClassesNeverCreatedByPolicy": [
    "MERGE_AUTHORITY",
    "DEPLOYMENT_AUTHORITY",
    "PRODUCT_AUTHORITY",
    "SEMANTIC_AUTHORITY",
    "SCIENTIFIC_CLAIM_AUTHORITY",
    "PHYSICAL_RETIREMENT_AUTHORITY",
    "GENERIC_COMMAND_AUTHORITY"
  ],
  "rules": [
    {"id":"P001_EXACT_HEAD","effect":"DENY","when":"SUBJECT_HEAD_DIFFERS_FROM_CURRENT_MAIN","reason":"AUTHORITY_FOR_H0_DOES_NOT_IMPLY_AUTHORITY_FOR_H1"},
    {"id":"P002_PROTECTED_PROJECT_PATH","effect":"DENY","when":"REQUEST_TOUCHES_PROTECTED_PROJECT_PREFIX_WITHOUT_EXPLICIT_PROJECT_AUTHORITY","reason":"SHARED_CONTROL_PLANE_MAY_NOT_INHERIT_PROJECT_AUTHORITY"},
    {"id":"P003_DIRECT_LEDGER_WRITE","effect":"DENY","when":"REQUEST_TOUCHES_CANONICAL_OPERATION_LEDGER_DIRECTLY","reason":"CANONICAL_LOCK_MANAGER_ONLY"},
    {"id":"P004_PHYSICAL_RETIREMENT","effect":"DENY","when":"REQUESTS_PHYSICAL_RETIREMENT_WITHOUT_SEPARATE_RETIREMENT_AUTHORITY","reason":"ELIGIBILITY_IS_NOT_AUTHORITY"},
    {"id":"P005_UNKNOWN_AUTHORITY","effect":"REVIEW_REQUIRED","when":"REQUESTED_AUTHORITY_CLASS_IS_UNKNOWN","reason":"UNKNOWN_AUTHORITY_FAILS_CLOSED_TO_REVIEW"},
    {"id":"P006_ATTESTATION_BOUNDARY","effect":"DENY","when":"ATTESTATION_IS_USED_AS_AUTHORITY_SOURCE","reason":"EVIDENCE_DOES_NOT_CREATE_AUTHORITY"},
    {"id":"P007_OBSERVER_SCOPE","effect":"DENY","when":"OBSERVATION_ATTEMPTS_TO_ENFORCE_ITS_HISTORICAL_CONSTRUCTION_SCOPE_ON_UNRELATED_OPERATION","reason":"OBSERVATION_IS_NOT_FOREIGN_OPERATION_SCOPE_AUTHORITY"},
    {"id":"P008_ALLOWED","effect":"ALLOW","when":"EXACT_HEAD_AND_NO_DENY_OR_REVIEW_CONDITION","reason":"DECLARATIVE_POLICY_PASS_ONLY"}
  ]
}

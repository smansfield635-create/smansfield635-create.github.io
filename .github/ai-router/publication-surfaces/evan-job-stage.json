{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "evan-job-stage",
  "description": "Standalone contractor Job Stage utility dashboard.",
  "checks": [
    {
      "path": "/prototypes/evan-job-stage/index.html",
      "includes": [
        "CONTRACTOR JOB CONTROL",
        "Job Stage",
        "Needs attention",
        "Jobs",
        "dashboard-v2.css",
        "dashboard-v2.js"
      ],
      "excludes": [
        "Evidence intake",
        "evidence gaps"
      ]
    },
    {
      "path": "/prototypes/evan-job-stage/dashboard-v2.js",
      "includes": [
        "Jane Doe",
        "John Smith",
        "Job Summary",
        "Contract & Changes",
        "Billing & Payments",
        "Job Files",
        "Closeout",
        "Remove job",
        "Archive job"
      ],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/prototypes/evan-job-stage/",
    "timeoutMs": 15000,
    "readySelector": "#workspace",
    "binding": {
      "mode": "direct-document",
      "path": "/prototypes/evan-job-stage/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [],
    "interactions": []
  }
}

{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "evidence",
  "description": "Diamond Gate public Evidence surface with current public condition inspection.",
  "checks": [
    {
      "path": "/evidence/",
      "includes": [
        "Current Public Condition",
        "What can the estate say right now?",
        "data-current-public-condition",
        "/evidence/current-public-condition.mjs?v=1&cb=prod3"
      ],
      "excludes": [
        "Breakthrough 4",
        "BT4 ·"
      ]
    },
    {
      "path": "/evidence/current-public-condition.mjs",
      "includes": [
        "evaluateSite",
        "site-entitlement.v1.mjs?cb=prod3",
        "data-condition-state",
        "data-condition-objects",
        "What restores it"
      ],
      "excludes": [
        "document.write"
      ]
    },
    {
      "path": "/evidence/readiness/bt4-site-governance/site-entitlement.v1.mjs",
      "includes": [
        "./entitlement-engine.v1.mjs?cb=prod1",
        "FETCH_DEADLINE_MS=10000",
        "WORLD_READY_DEADLINE_MS=30000",
        "ADAPTER_DEADLINE_MS=35000",
        "Promise.allSettled",
        "Scientific claim",
        "Audralia world/runtime",
        "Audralia diagnostic authority",
        "Exact-head public release"
      ],
      "excludes": [
        "/preview/bt4/entitlement-v1/entitlement-engine.v1.mjs"
      ]
    },
    {
      "path": "/evidence/readiness/bt4-site-governance/entitlement-engine.v1.mjs",
      "includes": [
        "serveRequestedState",
        "computeEntitlement",
        "QUALIFIED",
        "HELD"
      ]
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/evidence/",
    "readyAttribute": {
      "selector": "[data-current-public-condition]",
      "name": "data-ready",
      "contains": "true"
    },
    "timeoutMs": 45000,
    "failOnConsoleErrors": true
  }
}

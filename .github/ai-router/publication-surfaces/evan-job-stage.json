{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "evan-job-stage",
  "description": "Persistent editable contractor Job Stage v3 utility dashboard.",
  "checks": [
    {
      "path": "/prototypes/evan-job-stage/index.html",
      "includes": [
        "CONTRACTOR JOB CONTROL",
        "Job Stage",
        "Needs attention",
        "Jobs",
        "dashboard-v2.css?v=db8efef9",
        "dashboard-v2.js?v=db8efef9",
        "job-db-v3.js?v=db8efef9",
        "Backup",
        "Restore",
        "Saved on this device",
        "BUILD DB8EFEF9"
      ],
      "excludes": [
        "Evidence intake",
        "evidence gaps"
      ]
    },
    {
      "path": "/prototypes/evan-job-stage/dashboard-v2.js",
      "includes": [
        "Jane Doe",
        "John Smith",
        "Job Summary",
        "Contract & Changes",
        "Billing & Payments",
        "Job Files",
        "Closeout",
        "Remove job",
        "Archive job",
        "JobDB.putJob",
        "JobDB.putFile",
        "JobDB.backup",
        "JobDB.restore",
        "Edit job",
        "Update amounts"
      ],
      "excludes": []
    },
    {
      "path": "/prototypes/evan-job-stage/job-db-v3.js",
      "includes": [
        "indexedDB.open",
        "createObjectStore('jobs'",
        "createObjectStore('files'",
        "JOB_STAGE_BACKUP_V1"
      ],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/prototypes/evan-job-stage/",
    "timeoutMs": 15000,
    "readySelector": "#workspace",
    "binding": {
      "mode": "direct-document",
      "path": "/prototypes/evan-job-stage/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [],
    "interactions": []
  }
}

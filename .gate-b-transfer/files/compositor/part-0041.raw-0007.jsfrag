quiredId
    ) ??
    null
  );
}


function getExactCapacityDomainEvaluation(
  capacityEvaluation,
  requiredId
) {
  const check =
    findExactCapacityCheck(
      capacityEvaluation,
      requiredId
    );


  if (
    !check ||
    check.passed !== true ||
    !isPlainRecord(check.details)
  ) {
    return null;
  }


  return check.details;
}



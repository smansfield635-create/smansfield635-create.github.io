        {
          "actions": ["IDENTITY_REGISTRY_READ", "AUTHORIZATION_EVALUATE", "L2_STRIKE_REQUEST", "OBSERVABILITY_READ"],
          "resourcePrefixes": [".github/ai-router/platform-control-plane/", "control-plane://l2/"]
        }
      ]
    },
    "L2_STRIKE_CONSTRUCTOR": {
      "description": "May construct and self-test only within the admitted additive L2 platform-control-plane package and its exact strike workflow path.",
      "permissions": [
        {
          "actions": ["IDENTITY_REGISTRY_READ", "AUTHORIZATION_EVALUATE", "L2_COMPONENT_CONSTRUCT", "L2_SELF_TEST_EXECUTE", "AUTHORIZATION_RECEIPT_EMIT"],
          "resourcePrefixes": [".github/ai-router/platform-control-plane/"]
        },
        {
          "actions": ["L2_COMPONENT_CONSTRUCT", "L2_SELF_TEST_EXECUTE"],
          "exactResources": [".github/workflows/platform-control-plane-strike-v1.yml"]
        }
      ]
    },
    "L2_STRIKE_FRESH_VERIFIER": {
      "description": "May read, evaluate, and verify L2 strike outputs but may not construct, repair, merge, activate enforcement, or mutate other lanes.",
      "permissions": [
        {
          "actions": ["IDENTITY_REGISTRY_READ", "AUTHORIZATION_EVALUATE", "L2_COMPONENT_VERIFY", "L2_SELF_TEST_EXECUTE", "OBSERVABILITY_READ", "ENFORCEMENT_SHADOW_EVALUATE", "AUTHORIZATION_RECEIPT_EMIT"],
          "resourcePrefixes": [".github/ai-router/platform-control-plane/", "control-plane://l2/"]
        }
      ]
    },
    "L2_PLATFORM_AUTOMATION": {
      "description": "May evaluate authorization and emit bounded receipts during the dedicated L2 workflow; it does not receive repository mutation or external write authority from this role.",
      "permissions": [
        {
          "actions": ["IDENTITY_REGISTRY_READ", "AUTHORIZATION_EVALUATE", "L2_COMPONENT_VERIFY", "L2_SELF_TEST_EXECUTE", "FEDERATION_READ", "OBSERVABILITY_READ", "ENFORCEMENT_SHADOW_EVALUATE", "AUTHORIZATION_RECEIPT_EMIT"],
          "resourcePrefixes": [".github/ai-router/platform-control-plane/", "control-plane://l2/"]
        }
      ]
    }
  },
  "scopeLaws": [

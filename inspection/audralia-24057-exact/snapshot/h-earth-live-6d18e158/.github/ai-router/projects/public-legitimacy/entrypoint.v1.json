      "BIND_EXACT_TEXT_OR_BINARY_EVIDENCE_IDENTITY_WHERE_AUTHORIZED",
      "VALIDATE_RECEIPT_TO_ARTIFACT_RELATIONSHIPS",
      "FRESH_EXACT_HEAD_QUALIFICATION",
      "DRAFT_PR_REVIEW",
      "STOP_BEFORE_MERGE"
    ]
  },
  "evidenceModel": {
    "canonicalChain": [
      "AUTHORITATIVE_EXECUTION",
      "EXACT_TEXT_OR_BINARY_EVIDENCE",
      "HASHED_ARTIFACT_IDENTITY",
      "AUTHORITATIVE_RECEIPT",
      "SANITIZED_PUBLIC_PROJECTION"
    ],
    "binaryEvidenceAllowed": true,
    "binaryTransportCreatesAuthority": false,
    "publicDisclosureRequiresSeparateAuthorization": true,
    "referenceArtifactsCreateProductAuthority": false

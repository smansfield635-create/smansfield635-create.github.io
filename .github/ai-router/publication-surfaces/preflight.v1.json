{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "preflight.v1",
  "description": "Original DiamondGate project workspace migration; legacy surfaces retained.",
  "checks": [
    {
      "path": "/preflight/index.html",
      "includes": [
        "DiamondGate · Preflight",
        "noindex,nofollow,noarchive",
        "./assets/studio.css",
        "./assets/preflight-core.js",
        "./assets/studio.js",
        "id=\"idea\"",
        "id=\"checkBtn\"",
        "id=\"assessmentPanel\"",
        "id=\"prepareBtn\"",
        "id=\"resultPanel\""
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY",
        "ED25519_PRIVATE_KEY"
      ]
    },
    {
      "path": "/preflight/assets/studio.js",
      "includes": [
        "dataset.startup",
        "checkBtn",
        "assessFirstUse",
        "makeFirstRequest",
        "copyBtn",
        "saveBaselineBtn"
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY",
        "ED25519_PRIVATE_KEY"
      ]
    },
    {
      "path": "/preflight/assets/preflight-core.js",
      "includes": [
        "NOT_VERIFIED",
        "DGB_PREFLIGHT_USER_APPROVED_SNAPSHOT_v0_1",
        "assessFirstUse",
        "makeFirstRequest",
        "firstUseIdentity"
      ],
      "excludes": [
        "ED25519_PRIVATE_KEY"
      ]
    },
    {
      "path": "/preflight/assets/studio.css",
      "includes": [
        ".intro",
        ".input-card",
        ".assessment",
        ".questions"
      ],
      "excludes": [
        "javascript:"
      ]
    },
    {
      "path": "/preflight/saas-lab/index.html",
      "includes": [
        "DiamondGate • Development Lab",
        "noindex,nofollow,noarchive",
        "./styles.css",
        "./app.mjs",
        "id=\"project-input\"",
        "id=\"report-input\"",
        "id=\"preview\"",
        "id=\"continuation\""
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY",
        "sk-proj-"
      ]
    },
    {
      "path": "/preflight/saas-lab/app.mjs",
      "includes": [
        "receiveResult",
        "describeProgress",
        "generateContinuation",
        "Unassigned evidence",
        "textContent"
      ],
      "excludes": [
        "localStorage",
        "sessionStorage",
        "fetch(",
        "XMLHttpRequest",
        "GITHUB_TOKEN"
      ]
    },
    {
      "path": "/preflight/saas-lab/progression.mjs",
      "includes": [
        "validateState",
        "receiveResult",
        "generateContinuation",
        "milestone"
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY",
        "sk-proj-"
      ]
    },
    {
      "path": "/preflight/saas-lab/fixtures/sample-world-before.json",
      "includes": [
        "SAMPLE_WORLD",
        "CAM-FINAL"
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY"
      ]
    },
    {
      "path": "/preflight/app/index.html",
      "includes": [
        "DiamondGate — Pick up your work",
        "./dist/style.css",
        "./dist/app.mjs",
        "id=\"projects\"",
        "id=\"backup-file\"",
        "noindex,nofollow,noarchive"
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY",
        "sk-proj-"
      ]
    },
    {
      "path": "/preflight/chamber/index.html",
      "includes": [
        "workspace-controls",
        "workspace-ui.mjs",
        "noindex,nofollow,noarchive"
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY",
        "sk-proj-"
      ]
    },
    {
      "path": "/preflight/app/dist/workspace-bridge.mjs",
      "includes": [
        "diamondgate.workspace-backup.v1",
        "openChamberProject",
        "mergeWorkspaceBackup"
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY"
      ]
    },
    {
      "path": "/preflight/chamber/data/control-plane.json",
      "includes": [
        "DGB_OPERATIONS_CHAMBER_DASHBOARD_DATA_v1"
      ],
      "excludes": [
        "github_pat_",
        "-----BEGIN PRIVATE KEY",
        "sk-proj-"
      ]
    },
    {
      "path": "/preflight/chamber/data/study.json",
      "includes": [
        "DGB_HOSTED_STUDY_CAPTURE_v1"
      ],
      "excludes": [
        "github_pat_",
        "-----BEGIN PRIVATE KEY",
        "sk-proj-"
      ]
    },
    {
      "path": "/preflight/chamber/data/briefings.json",
      "includes": [
        "DGB_PROJECT_BRIEFINGS_v1"
      ],
      "excludes": [
        "github_pat_",
        "-----BEGIN PRIVATE KEY",
        "sk-proj-"
      ]
    },
    {
      "path": "/preflight/chamber/data/agents.json",
      "includes": [
        "DGB_CHAMBER_AGENT_DELIVERIES_v1"
      ],
      "excludes": [
        "github_pat_",
        "-----BEGIN PRIVATE KEY",
        "sk-proj-"
      ]
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/preflight/chamber/",
    "timeoutMs": 45000,
    "readySelector": "#continuing-study h3",
    "binding": {
      "mode": "direct-document",
      "path": "/preflight/chamber/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [
      "Loading the script 'https://static.cloudflareinsights.com/beacon.min.js/"
    ],
    "interactions": [
      {
        "name": "Published projects load without imports",
        "action": {
          "type": "click",
          "selector": ".nav [data-target=\"overview\"]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#projects [data-project=\"DIAMONDGATE_PREFLIGHT\"]"
          },
          {
            "type": "textContains",
            "selector": "#overview",
            "value": "H-Earth"
          }
        ]
      },
      {
        "name": "Instrument room retains existing services",
        "action": {
          "type": "click",
          "selector": ".nav [data-target=\"instrument-view\"]"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#instrument-view",
            "value": "Canonical Control"
          },
          {
            "type": "textContains",
            "selector": "#instrument-view",
            "value": "Epistemic Control Plane"
          }
        ]
      },
      {
        "name": "Refresh published records retains source dates",
        "action": {
          "type": "click",
          "selector": "#refresh"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#timestamp",
            "value": "2026-10-17"
          },
          {
            "type": "textContains",
            "selector": "#continuing-study",
            "value": "1,826"
          }
        ]
      }
    ]
  }
}

{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "auren",
  "description": "Auren Vale early-encounter Character Chamber publication contract.",
  "checks": [
    {
      "path": "/products/auren/",
      "includes": [
        "data-page=\"auren-early-encounter\"",
        "data-auren-chamber",
        "data-auren-mode=\"meet\"",
        "data-auren-thread",
        "data-auren-options",
        "data-auren-connection",
        "data-auren-context-route",
        "auren.voice.js",
        "auren.room.geometry.js",
        "auren.room.presentation.js",
        "auren.room.environment.js",
        "auren.chamber.js"
      ],
      "excludes": [
        "On Your Side AI",
        "Product Floor · Not His Room"
      ]
    },
    {
      "path": "/products/auren/auren.voice.js",
      "includes": [
        "AUREN_EARLY_ENCOUNTER_VOICE_V1",
        "AUREN_VALE_SANCTUARY_BUILDER_V1",
        "ARCHCOIN",
        "Education",
        "Five Flags",
        "Nutrition",
        "Book / Nine Summits",
        "Can I try it?",
        "Personally, I'm excited about it.",
        "Why does that matter to you?",
        "Then Elara is where this should go next.",
        "Talk to Elara"
      ],
      "excludes": [
        "On Your Side AI",
        "Education · Nutrition · Book"
      ]
    },
    {
      "path": "/products/auren/auren.room.geometry.js",
      "includes": [
        "AUREN_SPATIAL_CHAMBER_GEOMETRY_PROOF1_v1",
        "canonicalDimensions:false",
        "custody-apse",
        "rear-threshold"
      ],
      "excludes": []
    },
    {
      "path": "/products/auren/auren.room.presentation.js",
      "includes": [
        "AUREN_SPATIAL_CHAMBER_PRESENTATION_PROOF1_v1",
        "DOM_CSS_3D",
        "webglContextCount:0",
        "anchored:true"
      ],
      "excludes": [
        "getContext("
      ]
    },
    {
      "path": "/products/auren/auren.room.environment.js",
      "includes": [
        "AUREN_SPATIAL_CHAMBER_ENVIRONMENT_PROOF1_v1",
        "PROTECTED",
        "REVEALED",
        "custody-apse"
      ],
      "excludes": []
    },
    {
      "path": "/products/auren/auren.chamber.js",
      "includes": [
        "AUREN_EARLY_ENCOUNTER_RUNTIME_V1",
        "root.dataset.aurenReady=\"true\"",
        "expressionAnchors:true",
        "arbitraryChoiceCap:false",
        "topLevelModes:[\"meet\",\"products\"]",
        "productCount:5",
        "showConnection",
        "showRoute",
        "dataset.aurenEncounterState",
        "auren-expression-current",
        "auren-route-emergent",
        "meaningfulHistory.established",
        "instead of starting over"
      ],
      "excludes": [
        "slice(0,3)"
      ]
    },
    {
      "path": "/products/auren/index.css",
      "includes": [
        "[data-custody-state=\"REVEALED\"]",
        ".auren-connection",
        ".auren-prompt-dock",
        ".auren-context-route",
        "@media(max-width:700px)",
        "@media(max-width:420px)",
        "@media(prefers-reduced-motion:reduce)",
        "AUREN_P1_FULL_VIEWPORT_ENCOUNTER_SHELL_V1",
        "height:100dvh",
        "AUREN_P2_TRANSIENT_EXCHANGE_V1",
        "AUREN_P3_HANDOFF_TRANSFORMATION_V1",
        "AUREN_P4_AMBIENT_CONNECTION_V1"
      ],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/products/auren/",
    "timeoutMs": 30000,
    "readySelector": "[data-auren-chamber]",
    "readyAttribute": {
      "selector": "[data-auren-chamber]",
      "name": "data-auren-ready",
      "contains": "true"
    },
    "binding": {
      "mode": "direct-document",
      "path": "/products/auren/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "interactions": []
  }
}

{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "compass-gen1862",
  "description": "Compass root publication contract rebound to the bounded 38-second homepage cinematic inspection route, with Skip settlement plus mandatory visible Trophy successor identity and live renderer predicate.",
  "checks": [
    {
      "path": "/",
      "includes": [
        "<link rel=\"icon\" href=\"data:,\">",
        "data-compass-plan=\"COMPASS_INFORMATION_DELIVERY_20260814\"",
        "data-compass-root-renewal=\"gen1844-continuity\"",
        "data-compass-static-introduction",
        "data-compass-scene",
        "/assets/compass/compass.orientation-cinematic.css?v=gen1933-orientation-cinematic-v1&cb=88473442959299d6",
        "/assets/compass/compass.orientation-cinematic.js?v=gen1933-orientation-cinematic-v1&cb=88473442959299d6",
        "/assets/compass/compass.readiness-context-v1.js?v=compass-runtime-copy-owner-repair-gen1876&cb=d3fe9edfa21e0d0e",
        "/assets/compass/compass.crystals.js?v=gen1858-release-orbit-continuity&cb=cd2cbad0494852cc",
        "/assets/compass/compass.orbit-input.js?v=gen1846&cb=681410dac29d2dae",
        "/evidence/agentic-frontier/"
      ],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/?compassCinematicConstruction=1",
    "timeoutMs": 45000,
    "readySelector": "[data-main-orientation-film]",
    "binding": {
      "mode": "direct-document",
      "path": "/?compassCinematicConstruction=1"
    },
    "interactions": [
      {
        "name": "Settle bounded homepage cinematic before Compass verification",
        "action": {
          "type": "click",
          "selector": "[data-main-orientation-skip]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "[data-compass-root]:not([inert])"
          },
          {
            "type": "exists",
            "selector": "[data-capability-orbit][data-first-paint-authority=\"static\"]"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Activate Awards before Trophy verification",
        "action": {
          "type": "key",
          "selector": "[data-capability-orbit]",
          "key": "ArrowRight"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "[data-capability=\"awards\"]",
            "name": "data-active",
            "value": "true"
          },
          {
            "type": "attributeEquals",
            "selector": "[data-capability=\"awards\"]",
            "name": "aria-current",
            "value": "true"
          },
          {
            "type": "textContains",
            "selector": "[data-capability-orbit] .compass-orbit-status",
            "value": "Awards & Recognition"
          }
        ],
        "timeoutMs": 5000
      }
    ],
    "trophyPredicate": {
      "enabled": true,
      "fieldSelector": "[data-award-trophy]",
      "canvasSelector": "[data-award-trophy] canvas",
      "fallbackSelector": "[data-award-trophy] .compass-trophy-fallback",
      "approvedRenderer": "procedural-webgl-v8-integrated-recessed-plaque",
      "minFrames": 2,
      "requireVisible": true,
      "requireFallbackFalse": true,
      "requireNonblank": false
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true
  }
}

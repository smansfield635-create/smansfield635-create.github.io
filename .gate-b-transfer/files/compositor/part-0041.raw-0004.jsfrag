  const accessorKeys = [];


  for (const key of stringKeys) {
    const descriptor =
      Object.getOwnPropertyDescriptor(
        value,
        key
      );


    if (!descriptor) {
      continue;
    }


    if (descriptor.enumerable !== true) {
      nonEnumerableKeys.push(key);
    }



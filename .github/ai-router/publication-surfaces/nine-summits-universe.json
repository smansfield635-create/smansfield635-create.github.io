{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "nine-summits-universe",
  "description": "Nine Summits Universe: nine teaching relationships, book-first Gratitude selection, and accepted Harvest arrival with automatic motion and return.",
  "checks": [
    {
      "path": "/nine-summits/universe/index.html",
      "includes": [
        "Nine summits. One heart.",
        "Back to Compass",
        "/assets/compass/compass.orbit-physics.js",
        "id=\"reflection\"",
        "data-summit=\"8\"",
        "One choice. One path.",
        "Choose love.",
        "id=\"summit-teaching\"",
        "id=\"harvest-stage\"",
        "THE HARVEST · 02",
        "harvest-teaching-body",
        "harvest-reflection-toggle"
      ],
      "excludes": []
    },
    {
      "path": "/nine-summits/universe/universe.motion.js",
      "includes": [
        "DGB_COMPASS_ORBIT_PHYSICS",
        "admitHEarthPrimitiveBatch",
        "Gratitude begins with seeing.",
        "DGB_UNIVERSE",
        "const teachings",
        "harvest-activity-v1",
        "Generosity → Love · The Harvest"
      ],
      "excludes": []
    },
    {
      "path": "/assets/compass/compass.orbit-physics.js",
      "includes": [
        "DGB_COMPASS_ORBIT_PHYSICS",
        "constellationReleaseQuaternionAt",
        "releaseParameters"
      ],
      "excludes": []
    },
    {
      "path": "/nine-summits/generosity-harvest/index.html",
      "includes": [
        "harvest-encounter",
        "boot.mjs?v=harvest-landscape-20261128-v4",
        "width:max(100cqw,177.6833156217cqh)",
        "138.593cqh"
      ],
      "excludes": []
    },
    {
      "path": "/nine-summits/generosity-harvest/boot.mjs",
      "includes": [
        "harvest-ready-v1",
        "harvest-activity-v1"
      ],
      "excludes": []
    },
    {
      "path": "/nine-summits/generosity-harvest/preview.mjs",
      "includes": [
        "cycle.mjs?v=harvest-landscape-20261128-v4"
      ],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/nine-summits/universe/",
    "timeoutMs": 30000,
    "readySelector": "#universe-scene.ready",
    "binding": {
      "mode": "direct-document",
      "path": "/nine-summits/universe/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [
      "favicon.ico"
    ],
    "interactions": [
      {
        "name": "Begin with Gratitude from primary hero",
        "action": {
          "type": "click",
          "selector": "#explore-worlds"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#universe-scene[data-stage='approach'], #universe-scene[data-stage='encounter']"
          },
          {
            "type": "textContains",
            "selector": "#scene-note",
            "value": "Gratitude"
          }
        ],
        "timeoutMs": 7500
      },
      {
        "name": "Open nine summits list",
        "action": {
          "type": "click",
          "selector": "#path-list summary"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#path-list[open]"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Select the approved Gratitude summit",
        "action": {
          "type": "click",
          "selector": "[data-summit=\"4\"]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#universe-scene[data-stage='approach'], #universe-scene[data-stage='encounter']"
          },
          {
            "type": "textContains",
            "selector": "#scene-note",
            "value": "Gratitude"
          }
        ],
        "timeoutMs": 7500
      },
      {
        "name": "Switch to Generosity and Love",
        "action": {
          "type": "click",
          "selector": "[data-summit=\"1\"]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#universe-scene[data-stage='encounter'] #harvest-stage[data-state='ready']"
          },
          {
            "type": "textContains",
            "selector": "#scene-note",
            "value": "The Harvest"
          },
          {
            "type": "attributeEquals",
            "selector": "#harvest-stage",
            "name": "data-playing",
            "value": "true"
          },
          {
            "type": "attributeEquals",
            "selector": "#love-world-hud",
            "name": "data-collapsed",
            "value": "true"
          }
        ],
        "timeoutMs": 15000
      },
      {
        "name": "Open compact Harvest reflection",
        "action": {
          "type": "click",
          "selector": "#harvest-reflection-toggle"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "#love-world-hud",
            "name": "data-collapsed",
            "value": "false"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Restore landscape-first Harvest",
        "action": {
          "type": "click",
          "selector": "#harvest-reflection-toggle"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "#love-world-hud",
            "name": "data-collapsed",
            "value": "true"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Pause Harvest from quiet visitor control",
        "action": {
          "type": "click",
          "selector": "#harvest-motion-toggle"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "#harvest-stage",
            "name": "data-playing",
            "value": "false"
          },
          {
            "type": "textContains",
            "selector": "#harvest-motion-toggle",
            "value": "Resume motion"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Resume Harvest",
        "action": {
          "type": "click",
          "selector": "#harvest-motion-toggle"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "#harvest-stage",
            "name": "data-playing",
            "value": "true"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Return to the universe",
        "action": {
          "type": "click",
          "selector": "#love-return"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#universe-scene[data-stage='arrival'] #harvest-stage[data-state='idle']"
          }
        ],
        "timeoutMs": 15000
      }
    ]
  }
}

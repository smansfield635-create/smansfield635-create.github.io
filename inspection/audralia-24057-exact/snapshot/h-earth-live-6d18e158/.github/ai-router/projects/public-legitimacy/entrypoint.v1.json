  "localExecution": {
    "allowed": true,
    "requirements": [
      "FULL_REPOSITORY_CHECKOUT",
      "EXACT_SUBJECT_HEAD",
      "CLEAN_WORKTREE",
      "COMMAND_EMITTED_ADMISSION_RECEIPT",
      "ROUTER_RECEIPT_FOR_EVERY_AFFECTED_PATH"
    ]
  },
  "stoppingRules": [
    "STOP_IF_CANONICAL_INTAKE_IS_NOT_ADMITTED_AND_LOCKED",
    "STOP_IF_ROUTER_DISPOSITION_IS_BLOCK_REVIEW_REQUIRED_OR_STOP_FOR_A_MUTATION_PATH",
    "STOP_IF_PRIVATE_OR_UNAUTHORIZED_EVIDENCE_WOULD_BE_DISCLOSED",
    "STOP_IF_ARTIFACT_TRANSPORT_IS_TREATED_AS_ADMISSION_QUALIFICATION_OR_RELEASE_AUTHORITY",
    "STOP_IF_HASH_OR_RECEIPT_IS_PROMOTED_TO_EXTERNAL_CERTIFICATION_OR_FACTUAL_TRUTH",
    "STOP_BEFORE_MERGE_WITHOUT_SEPARATE_EXACT_HEAD_AUTHORITY"
  ]

{
  "schema": "PUBLICATION_RELEASE_CONTRACT_v1",
  "status": "ACTIVE",
  "repository": "smansfield635-create/smansfield635-create.github.io",
  "purpose": "Provide one deterministic publication path for every approved public page, file, route, environment, and future public surface in this repository.",
  "releaseClasses": {
    "BOUNDED_PAGE_RELEASE": {
      "includes": ["STATIC_EDITORIAL_MICRO", "BOUNDED_LAYOUT", "BOUNDED_STYLE", "BOUNDED_COPY", "BOUNDED_PRESENTATION_ORDER", "BOUNDED_EXISTING_INTERACTION_REPAIR_WITHOUT_NEW_RUNTIME_AUTHORITY"],
      "requiredSequence": ["APPROVED_COMMIT", "EXPLICIT_DEPLOYMENT", "LIVE_EXACT_HEAD_VERIFICATION"],
      "canonicalOperationIntakeRequired": false,
      "pageExcellenceChainRequired": false,
      "newReleaseBranchRequired": false,
      "dummyReleaseCommitRequired": false,
      "legacyImplicitPagesTriggerAllowed": false
    },
    "RUNTIME_OR_NEW_DEVELOPMENT": {
      "includes": ["NEW_RUNTIME_OWNER", "STATE_MACHINE_CHANGE", "CONTROLLER_CHANGE", "NEW_INTERACTIVE_SYSTEM", "NEW_ENVIRONMENT", "NEW_PRODUCT", "ARCHITECTURE_OR_AUTHORITY_CHANGE", "AMBIGUOUS_OR_MIXED_SCOPE"],
      "requiredSequence": ["APPLICABLE_GOVERNANCE_AND_QUALIFICATION", "APPROVED_COMMIT", "EXPLICIT_DEPLOYMENT", "LIVE_EXACT_HEAD_VERIFICATION"],
      "canonicalOperationIntakeRequired": true
    }
  },
  "deployment": {
    "capabilityId": "PAGES_EXACT_HEAD_DEPLOY",
    "capabilityRegistry": ".github/ai-router/workflow-dispatch-capability.v1.json",
    "workflow": ".github/workflows/pages-exact-head-deploy-v3.yml",
    "inputs": ["target_sha", "surface_id"],
    "authority": "EXPLICIT_GITHUB_PAGES_ARTIFACT_DEPLOYMENT",
    "sourceRule": "DEPLOY_EXACT_REQUESTED_COMMIT_ONLY",
    "mainRequirement": "TARGET_SHA_MUST_EQUAL_CURRENT_MAIN_UNLESS_EXPLICIT_ROLLBACK_MODE_EXISTS",
    "artifactHeadMarker": ".well-known/dgb-release.json",
    "surfaceManifestRoot": ".github/ai-router/publication-surfaces/",
    "surfaceManifestSchema": ".github/ai-router/publication-surfaces/schema.v1.json",
    "surfaceResolutionRule": "SURFACE_ID_RESOLVES_ONLY_TO_COMMITTED_DECLARATIVE_VERIFICATION_MANIFEST_AT_TARGET_SHA",
    "bindingRule": "WORKFLOW_IDENTITY_MUST_MATCH_AI_ENTRYPOINT_AND_PAGES_EXACT_HEAD_DEPLOY_CAPABILITY"
  },
  "verification": {
    "required": true,
    "method": "FETCH_PUBLIC_RELEASE_MARKER_COMPARE_TARGET_SHA_AND_SURFACE_MANIFEST_THEN_RUN_DECLARED_STATIC_AND_OPTIONAL_RUNTIME_CHECKS",
    "successResult": "LIVE_EXACT_HEAD_VERIFIED",
    "failureResult": "DEPLOYMENT_NOT_PROVEN",
    "appearanceOnlyVerificationSufficient": false,
    "exactHeadProofRequired": true,
    "surfaceSpecificProofRequired": true,
    "runtimeProofRequiredWhenManifestDeclaresRuntime": true,
    "failedAssertionLocalizationRequiredBeforeRepair": true,
    "blindRerunAllowed": false,
    "verificationFailureCreatesProductMutationAuthority": false
  },
  "universality": {
    "scope": "ALL_PUBLIC_SURFACES_IN_REPOSITORY",
    "examples": ["COMPASS", "AUDRALIA", "H_EARTH", "LAWS", "PRODUCTS", "HOME", "DOOR", "SHOWROOM", "RESEARCH", "FUTURE_PUBLIC_SURFACES"],
    "projectSpecificDeploymentWorkflowAllowed": false,
    "surfaceSpecificVerificationManifestAllowed": true,
    "newSurfaceRequiresDeploymentWorkflowMutation": false,
    "newSurfaceRequiresCommittedVerificationManifest": true
  },
  "rules": [
    "MERGE_IS_NOT_DEPLOYMENT",
    "DEPLOYMENT_IS_NOT_VERIFIED_LIVE_RELEASE",
    "LOCALIZE_EXACT_FAILED_ASSERTION_BEFORE_PUBLICATION_REPAIR",
    "DO_NOT_BLINDLY_RERUN_AN_UNCHANGED_FAILED_PUBLICATION",
    "BOUNDED_PAGE_RELEASES_MUST_NOT_ESCALATE_TO_RUNTIME_GOVERNANCE_WITHOUT_RUNTIME_OR_AUTHORITY_DELTA",
    "DO_NOT_USE_DUMMY_COMMITS_RELEASE_BRANCH_NUDGES_CACHE_CHURN_OR_PUSH_TRIGGERED_PUBLICATION",
    "ONE_EXPLICIT_DEPLOYMENT_AUTHORITY_FOR_ALL_PUBLIC_SURFACES",
    "ONE_EXACT_HEAD_LIVE_RECEIPT",
    "PUBLIC_RELEASE_REQUIRES_SURFACE_SPECIFIC_BYTE_PROOF",
    "PUBLIC_RUNTIME_RELEASE_REQUIRES_DECLARED_RUNTIME_PROOF",
    "CANONICAL_PUBLICATION_WORKFLOW_IDENTITY_MUST_AGREE_ACROSS_ENTRYPOINT_CONTRACT_AND_CAPABILITY_REGISTRY",
    "NO_PROJECT_ROOM_MAY_INVENT_A_PARALLEL_PUBLICATION_WORKFLOW"
  ]
}

{
  "schema": "L2_REPOSITORY_ENFORCEMENT_POLICY_v1",
  "policyId": "L2_REPOSITORY_ENFORCEMENT_SHADOW_POLICY_v1",
  "version": "1.0.0",
  "status": "ACTIVE_SHADOW_ONLY_WHEN_REFERENCED",
  "mode": "SHADOW_ONLY",
  "targetRepository": "smansfield635-create/smansfield635-create.github.io",

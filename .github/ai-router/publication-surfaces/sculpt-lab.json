{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "sculpt-lab",
  "description": "Protected original M1.3 rabbit 64-pose playback on existing native four-view Sculpt Lab, with neutral technical fallback. Original ZIP remains owner-private and local-file selected; no artistic/Harvest animation acceptance.",
  "checks": [
    {
      "path": "/graphics-engine/sculpt-lab/index.html",
      "includes": [
        "Diamond Gate | Rabbit Motion Review",
        "Original rabbit · motion preview",
        "id=\"hero\"",
        "id=\"side\"",
        "id=\"front\"",
        "id=\"rear\"",
        "<script type=\"importmap\">",
        "dgb.native-sculpt-session.v1.mjs?asset=255ce35aa72a16b297d8c150ce452436cfee0d1d",
        "dgb.native-sculpt-browser.v1.mjs?asset=81eec73f2cb90a0ea9797f9c2b6f6614eca1f3b3",
        "window.__dgbSculptLab",
        "No original ZIP has been loaded or verified.",
        "id=\"m13Play\"",
        "id=\"m13Timeline\"",
        "id=\"m13Rest\"",
        "id=\"m13Hop\""
      ],
      "excludes": [
        "https://drive.google.com/file/d/19hkrfnEsL84neg8aTbmhkBkOlx5O00s3"
      ]
    },
    {
      "path": "/assets/engine/dgb.native-sculpt-browser.v1.mjs",
      "includes": [
        "createNativeSculptStudio",
        "makeNeutralSculptRegionFixture",
        "./dgb.native-sculpt-session.v1.mjs",
        "createNativeWebGLDevice"
      ],
      "excludes": []
    },
    {
      "path": "/assets/engine/dgb.native-sculpt-session.v1.mjs",
      "includes": [
        "CONSERVATIVE_AABB_SWEEP_UNCHANGED_NARROWPHASE",
        "QUALIFIED_SOURCE_DELTA_ALL_AFFECTED_PAIRS",
        "createM13OriginalSource"
      ],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/graphics-engine/sculpt-lab/",
    "timeoutMs": 45000,
    "readySelector": "#status",
    "binding": {
      "mode": "direct-document",
      "path": "/graphics-engine/sculpt-lab/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [],
    "interactions": [
      {
        "name": "Neutral four-view WebGL startup",
        "action": {
          "type": "click",
          "selector": "#returnNeutral"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#status",
            "value": "Vertices 273"
          },
          {
            "type": "textContains",
            "selector": "#status",
            "value": "Active views 4"
          },
          {
            "type": "exists",
            "selector": "#hero"
          },
          {
            "type": "exists",
            "selector": "#side"
          },
          {
            "type": "exists",
            "selector": "#front"
          },
          {
            "type": "exists",
            "selector": "#rear"
          }
        ],
        "timeoutMs": 15000
      }
    ]
  }
}

{
  "anti_escape_rules": [
    "NO_POSTHOC_RELATION_REDEFINITION",
    "NO_POSTHOC_DOMAIN_EXCLUSION_BASED_ON_RESULT_DIRECTION",
    "NO_RECLASSIFICATION_OF_FAILED_PREDICTION_AS_NONCONSTITUTIVE_AFTER_UNBLINDING",
    "NO_THRESHOLD_REPAIR",
    "NO_UNREGISTERED_BASELINE_REMOVAL"
  ],
  "failure_classes": {
    "CUSTODY_FAILURE": [
      "TRUTH_OR_OUTCOME_LEAKAGE",
      "HASH_OR_TIMESTAMP_MISMATCH",
      "POSTFREEZE_MUTATION"
    ],
    "DOMAIN_MODEL_FAILURE": [
      "ONE_DOMAIN_ROUTE_DICTIONARY_IS_WRONG_WHILE_CROSS_DOMAIN_CANDIDATE_REMAINS_TESTABLE"
    ],
    "MEASUREMENT_FAILURE": [
      "REQUIRED_VARIABLES_NOT_OBSERVABLE",
      "INTERVENTION_NOT_EXECUTED_AS_DECLARED"
    ],
    "REDUNDANCY": [
      "STRONGEST_BASELINE_MATCHES_OR_EXCEEDS_THEORY_MODEL_WITHOUT_UNIQUE_DISCRIMINATION"
    ],
    "THEORY_UNDERDEFINITION": [
      "QUALIFIED_OBSERVERS_CANNOT_RECOVER_COMPATIBLE_BOUNDARIES",
      "QUALIFIED_OBSERVERS_CANNOT_RECOVER_COMPATIBLE_CONSTITUTIVE_RELATIONS"
    ],
    "UNIVERSAL_CANDIDATE_FAILURE": [
      "VALID_RELATION_SPECIFIC_PREDICTION_FAILS_ACROSS_ADMISSIBLE_SYSTEMS",
      "UNRELATED_COMPENSATION_SYSTEMATICALLY_RESTORES_ROUTE",
      "MATCHED_OUTPUT_STATES_SHOW_NO_DIFFERENTIAL_FUTURE_RESPONSE"
    ]
  },
  "version": "1.0.0"
}

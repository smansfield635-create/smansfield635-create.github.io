{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AHBK_OUTPUT_SCHEMA_v1",
  "title": "AHBK conformant realization output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ahbk_output"
  ],
  "properties": {
    "ahbk_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specification",
        "binding",
        "status",
        "candidates",
        "order",
        "evaluations",
        "boundaries",
        "claims",
        "provenance"
      ],
      "properties": {
        "specification": {
          "$ref": "#/$defs/IdentityDigest"
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "domain",
            "object_under_test",
            "preregistration_id",
            "digest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "object_under_test": {
              "type": "string",
              "minLength": 1
            },
            "preregistration_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "digest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "structural_conformance",
            "execution_authorization",
            "experimental_completion",
            "claim_entitlement",
            "reason_codes"
          ],
          "properties": {
            "structural_conformance": {
              "enum": [
                "PASS",
                "FAIL"
              ]
            },
            "execution_authorization": {
              "enum": [
                "AUTHORIZED",
                "PROHIBITED",
                "NOT_APPLICABLE"
              ]
            },
            "experimental_completion": {
              "enum": [
                "COMPLETE",
                "UNCOMPLETED",
                "INVALID"
              ]
            },
            "claim_entitlement": {
              "enum": [
                "ENTITLED",
                "NOT_ENTITLED",
                "PARTIAL"
              ]
            },
            "reason_codes": {
              "$ref": "#/$defs/StringArray"
            }
          }
        },
        "candidates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "test",
            "support",
            "excluded"
          ],
          "properties": {
            "test": {
              "$ref": "#/$defs/ObjectArray"
            },
            "support": {
              "$ref": "#/$defs/ObjectArray"
            },
            "excluded": {
              "$ref": "#/$defs/ObjectArray"
            }
          }
        },
        "order": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation_digest",
            "comparable_pairs",
            "incomparable_pairs",
            "disconnected_components",
            "invariant_receipt"
          ],
          "properties": {
            "relation_digest": {
              "type": "string",
              "minLength": 1
            },
            "comparable_pairs": {
              "$ref": "#/$defs/PairArray"
            },
            "incomparable_pairs": {
              "$ref": "#/$defs/PairArray"
            },
            "disconnected_components": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/StringArray"
              }
            },
            "invariant_receipt": {
              "$ref": "#/$defs/ReceiptRef"
            }
          }
        },
        "evaluations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluation_state",
            "classifications",
            "survive_set",
            "fail_set",
            "uninterpretable_map",
            "missing_obligations"
          ],
          "properties": {
            "evaluation_state": {
              "enum": [
                "NOT_EVALUATED",
                "PARTIAL",
                "COMPLETE"
              ]
            },
            "classifications": {
              "$ref": "#/$defs/ObjectArray"
            },
            "survive_set": {
              "$ref": "#/$defs/StringArray"
            },
            "fail_set": {
              "$ref": "#/$defs/StringArray"
            },
            "uninterpretable_map": {
              "$ref": "#/$defs/ObjectArray"
            },
            "missing_obligations": {
              "$ref": "#/$defs/ObjectArray"
            }
          }
        },
        "boundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "R_star",
            "F_min",
            "I",
            "N",
            "U"
          ],
          "properties": {
            "R_star": {
              "$ref": "#/$defs/StringArray"
            },
            "F_min": {
              "$ref": "#/$defs/StringArray"
            },
            "I": {
              "$ref": "#/$defs/PairArray"
            },
            "N": {
              "$ref": "#/$defs/PairArray"
            },
            "U": {
              "$ref": "#/$defs/ObjectArray"
            }
          }
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "language_id",
            "entitled_claims",
            "claim_ceiling",
            "forbidden_claims",
            "claim_receipt"
          ],
          "properties": {
            "language_id": {
              "type": "string",
              "minLength": 1
            },
            "entitled_claims": {
              "$ref": "#/$defs/ObjectArray"
            },
            "claim_ceiling": {
              "$ref": "#/$defs/ObjectArray"
            },
            "forbidden_claims": {
              "$ref": "#/$defs/ObjectArray"
            },
            "claim_receipt": {
              "oneOf": [
                {
                  "$ref": "#/$defs/ReceiptRef"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "receipts",
            "deviations",
            "final_receipt_digest"
          ],
          "properties": {
            "receipts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ReceiptRef"
              }
            },
            "deviations": {
              "$ref": "#/$defs/ObjectArray"
            },
            "final_receipt_digest": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "IdentityDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ReceiptRef": {
      "type": "object",
      "minProperties": 1
    },
    "StringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "ObjectArray": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "PairArray": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string"
        }
      }
    }
  }
}

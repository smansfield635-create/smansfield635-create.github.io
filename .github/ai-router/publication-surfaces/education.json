{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "education",
  "description": "Diamond Gate Bridge Education learner chamber at /products/education/: Gate 2 continuous six-card spatial learner rail with EN/ES/ZH help-language shell and preserved English placement demo.",
  "checks": [
    {
      "path": "/products/education/index.html",
      "includes": [
        "EDUCATION_COHERISCOPE_PATTERN_PLACEMENT_DEMO_v1",
        "English Fluency Accelerator",
        "Possibility",
        "Understanding",
        "Action",
        "Progress",
        "Independence",
        "Achievement",
        "data-shell-language=\"en\"",
        "data-shell-language=\"es\"",
        "data-shell-language=\"zh\"",
        "data-chamber-action",
        "data-chamber-practice-action",
        "data-chamber-check-action",
        "pointermove",
        "NATIVE_SUPPORTED",
        "BILINGUAL_BRIDGED",
        "TARGET_DOMINANT",
        "TARGET_ONLY",
        "ABOVE_PHASE_1",
        "demo_entry_point",
        "data-no-backend=\"true\"",
        "data-no-persistence=\"true\"",
        "edu-spatial-mini",
        "data-flip"
      ],
      "excludes": [
        "Public Face",
        "Technical Face",
        "Education architecture standards",
        "Engineering detail",
        "data-speech-measurement=\"true\"",
        "data-listening-measurement=\"true\"",
        "data-edu-tabs",
        "The target-language curriculum is not yet available in this demo."
      ]
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/products/education/",
    "timeoutMs": 15000,
    "readySelector": "html[data-education-demo-ready=\"true\"]",
    "binding": {
      "mode": "direct-document",
      "path": "/products/education/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [],
    "interactions": [
      {
        "name": "Keyboard advances to Understanding",
        "action": {
          "type": "key",
          "selector": "[data-edu-viewport]",
          "key": "ArrowRight"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "[data-edu-live]",
            "value": "Understanding"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Active card Open enters Level 2",
        "action": {
          "type": "click",
          "selector": ".edu-standard-card[data-active=\"true\"] [data-flip]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#edu-detail-surface:not([hidden])"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Return to orbit closes Level 2",
        "action": {
          "type": "click",
          "selector": "#edu-detail-return"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "#edu-detail-surface",
            "name": "hidden",
            "value": ""
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Find starting point opens learner intake",
        "action": {
          "type": "click",
          "selector": "[data-start-demo]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "[data-demo-stage=\"intake\"]:not([hidden])"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Top Spanish selector controls learner interface",
        "action": {
          "type": "click",
          "selector": "[data-shell-language=\"es\"]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "html",
            "name": "lang",
            "value": "es"
          },
          {
            "type": "exists",
            "selector": "[data-demo-stage=\"intake\"]:not([hidden])"
          }
        ],
        "timeoutMs": 5000
      }
    ]
  }
}

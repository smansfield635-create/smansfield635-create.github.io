{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "door-mirrorland",
  "description": "Door dark-mirror monolith threshold environment layered around the frozen Cycle-7 carousel and card renderers without adopting the legacy Mirrorland renderer.",
  "checks": [
    {
      "path": "/door/",
      "includes": [
        "data-page=\"door\"",
        "data-version=\"DOOR-EXPLORE-ANIMATION-COHERENCE-V1-CYCLE7\"",
        "data-door-card-count=\"6\"",
        "data-environment=\"mirrorland-door-monolith-v3\"",
        "data-door-mirrorland",
        "data-door-monolith-stage",
        "Dark mirrored Mirrorland threshold",
        "Mirrorland threshold",
        "Six ways through.",
        "/assets/door-explore/door.environment.css?v=door-mirrorland-monolith-g3-20260909",
        "/assets/door-explore/door.environment.js?v=door-mirrorland-monolith-g3-20260909",
        "carousel.dataset.carouselAuthority='page-bound-v1'"
      ],
      "excludes": [
        "DGB_COMPASS_MIRRORLAND_WINDOW_HARDENED_v2",
        "data-environment=\"expedition-map-v1\"",
        "data-environment=\"mirrorland-door-v1\"",
        "data-environment=\"mirrorland-door-depth-v2\"",
        "door-window-rib",
        "door-pane cyan",
        "door-pane violet",
        "Six paths wait beyond the glass."
      ]
    },
    {
      "path": "/assets/door-explore/door.environment.js",
      "includes": [
        "DOOR_MIRRORLAND_MONOLITH_ENVIRONMENT_v3",
        "data-door-mirrorland-ready",
        "mirrorMaterialPrimary: true",
        "stainedGlassGeometryPresent: false",
        "mobileStaticPerspective",
        "pointer-monolith-parallax",
        "static-mobile-monolith",
        "legacyMirrorlandRendererAdopted: false"
      ],
      "excludes": [
        "DGB_COMPASS_MIRRORLAND_WINDOW_HARDENED_v2",
        "DOOR_MIRRORLAND_DEPTH_ENVIRONMENT_v2"
      ]
    },
    {
      "path": "/assets/door-explore/door.environment.css",
      "includes": [
        "DOOR_MIRRORLAND_MONOLITH_ENVIRONMENT_v3",
        ".door-monolith-scene",
        ".door-portal-front",
        ".door-side-left",
        ".door-side-right",
        ".door-route-signal",
        ".door-floor-reflection",
        "@media(prefers-reduced-motion:reduce)"
      ],
      "excludes": [
        ".door-window-rib",
        ".door-pane.cyan",
        ".door-pane.violet"
      ]
    },
    {
      "path": "/assets/door-explore/spatial-v2.css",
      "includes": [
        ".carousel",
        ".route-card",
        ".home-identity-v2-stage"
      ],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/door/",
    "timeoutMs": 30000,
    "readySelector": "[data-door-mirrorland]",
    "readyAttribute": {
      "selector": "[data-door-mirrorland]",
      "name": "data-door-mirrorland-ready",
      "contains": "true"
    },
    "binding": {
      "mode": "direct-document",
      "path": "/door/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true
  }
}

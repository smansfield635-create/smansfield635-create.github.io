{
  "schema": "REPOSITORY_AI_PROJECT_ENTRYPOINT_v1",
  "projectId": "METHODS_INFORMATION_BENCHMARK",
  "status": "ACTIVE_REGISTERED_PROJECT",
  "ownedPathPrefixes": [
    "control-plane/methods-information-benchmark/",
    "methods-information-benchmark/"
  ],
  "ownedExactPaths": [
    ".github/workflows/methods-information-benchmark-pre-role-bootstrap.yml"
  ],
  "entrypoint": ".github/ai-router/projects/methods-information-benchmark/entrypoint.v1.json",
  "authorityBoundary": [
    "ROUTES_WITHOUT_ACTIVATING_PERMANENT_ROLES",
    "USER_ORIGIN_SEED_IS_ONLY_GENESIS_AUTHORITY",
    "PR_551_IS_SOLE_CANONICAL_GENESIS_CANDIDATE",
    "PR_550_IS_NONCANONICAL_IMPLEMENTATION_DONOR_ONLY",
    "CONVERSATION_MEMORY_AND_PRIVATE_STATE_NONAUTHORITATIVE",
    "STOP_ON_AMBIGUOUS_BENCHMARK_OR_ROLE_AUTHORITY",
    "EXACT_HEAD_BUILDER_RECEIPT_REQUIRED",
    "FRESH_VERIFIER_MUST_CONSUME_AUTHENTIC_BUILDER_CUSTODY"
  ],
  "requiredInstructions": [
    "control-plane/methods-information-benchmark/AGENTS.md"
  ],
  "registries": [
    "control-plane/methods-information-benchmark/bootstrap/bootstrap-bundle.v1.json"
  ],
  "procedures": {
    "bootstrapSelfTest": {
      "command": "node methods-information-benchmark/validation/pre-role-bootstrap/bootstrap.mjs self-test --expected-head <EXACT_CANDIDATE_HEAD> --base-head <EXACT_BASE_HEAD> --output <OUTSIDE_REPOSITORY_OR_IGNORED_PATH>/self-test.json",
      "workflow": ".github/workflows/methods-information-benchmark-pre-role-bootstrap.yml"
    },
    "builderReceipt": {
      "command": "node methods-information-benchmark/validation/pre-role-bootstrap/bootstrap.mjs builder-receipt --expected-head <EXACT_CANDIDATE_HEAD> --base-head <EXACT_BASE_HEAD> --execution-holder <BUILDER_EXECUTION_HOLDER> --changed-path-map-output <OUTSIDE_REPOSITORY_OR_IGNORED_PATH>/changed-path-map.json --output <OUTSIDE_REPOSITORY_OR_IGNORED_PATH>/builder-receipt.json"
    },
    "independentBootstrapVerifier": {
      "locator": "control-plane/methods-information-benchmark/locators/fresh-room-entry.locator.v1.json",
      "command": "node methods-information-benchmark/validation/pre-role-bootstrap/bootstrap.mjs independent-bootstrap-verifier --builder-receipt <BUILDER_RECEIPT> --builder-fingerprint <BUILDER_FINGERPRINT> --builder-candidate-head <EXACT_HEAD> --builder-execution-holder <BUILDER_HOLDER> --verifier-execution-holder <FRESH_VERIFIER_HOLDER> --origin-seed-blob <SEED_BLOB> --origin-seed-sha256 <SEED_SHA256> --changed-path-blob-map <CHANGED_PATH_MAP> --output <OUTSIDE_REPOSITORY_OR_IGNORED_PATH>/verification.json"
    },
    "permanentRoleAdmission": {
      "locator": "control-plane/methods-information-benchmark/locators/role-system-entry.locator.v1.json",
      "command": "node methods-information-benchmark/validation/pre-role-bootstrap/bootstrap.mjs role-holder-admission --locator <LOCATOR> --operation <OPERATION_ID> --room <ROOM_EXECUTION_ID> --output <OUTSIDE_REPOSITORY_OR_IGNORED_PATH>/admission.json"
    }
  },
  "localExecution": {
    "precondition": "CLEAN_EXACT_HEAD_GIT_CHECKOUT",
    "fallbackWhenUnavailable": "USE_DECLARED_GITHUB_ACTIONS_WORKFLOW"
  },
  "githubActionsExecution": {
    "workflow": ".github/workflows/methods-information-benchmark-pre-role-bootstrap.yml",
    "requiredArtifact": "methods-information-benchmark-pre-role-bootstrap-receipts",
    "requiredExactHeadFiles": [
      "EXPECTED_HEAD",
      "EXECUTED_HEAD"
    ],
    "requiredBuilderEvidence": [
      "builder-receipt.json",
      "changed-path-blob-map.json",
      "fingerprint.json"
    ]
  },
  "stoppingRules": [
    "WORKFLOW_EXECUTED_NONCANDIDATE_HEAD",
    "ROLE_SYSTEM_INACTIVE",
    "INDEPENDENT_VERIFICATION_MISSING",
    "CANONICAL_BENCHMARK_AMBIGUOUS",
    "PRIVATE_STATE_DEPENDENCY",
    "BUILDER_RECEIPT_MISSING",
    "BUILDER_VERIFIER_HOLDER_COLLISION",
    "FINGERPRINT_MISMATCH",
    "CHANGED_PATH_BLOB_MAP_MISMATCH"
  ]
}

{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "governance-bridge",
  "description": "Direct-access Governance Bridge prospective-client demonstration. Separate from ordinary website navigation.",
  "checks": [
    {
      "path": "/governance-bridge/index.html",
      "includes": [
        "<meta name=\"robots\" content=\"noindex,nofollow\">",
        "The Governance Bridge",
        "You already know how to run a business without being everywhere at once.",
        "Different businesses. Different problems. One management principle underneath them.",
        "Start with the problem you already know.",
        "Say it the way an owner would say it.",
        "Know what changed before it becomes expensive.",
        "Scale local freedom without scaling inconsistency.",
        "Know which problems actually need you.",
        "Keep the operation together when the plan comes apart.",
        "Know what you're betting on before the money moves.",
        "Protect the promise, not uniformity.",
        "The Bridge"
      ],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/governance-bridge/",
    "waitMs": 1500,
    "assertions": [
      {
        "type": "selectorExists",
        "selector": "[data-governance-panel-trigger]"
      },
      {
        "type": "selectorExists",
        "selector": ".governance-panel"
      },
      {
        "type": "selectorExists",
        "selector": "[data-governance-mode=\"failure-response\"]"
      }
    ],
    "interactions": [
      {
        "name": "open-governance-panel",
        "action": {
          "type": "click",
          "selector": "[data-governance-panel-trigger]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "[data-governance-panel-trigger]",
            "name": "aria-expanded",
            "value": "true"
          },
          {
            "type": "attributeContains",
            "selector": ".governance-panel",
            "name": "class",
            "value": "is-open"
          },
          {
            "type": "attributeEquals",
            "selector": ".governance-panel",
            "name": "aria-hidden",
            "value": "false"
          },
          {
            "type": "exists",
            "selector": ".governance-panel.is-open [data-governance-mode=\"failure-response\"]"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "select-failure-response",
        "action": {
          "type": "click",
          "selector": ".governance-panel.is-open [data-governance-mode=\"failure-response\"]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "[data-governance-mode=\"failure-response\"]",
            "name": "aria-selected",
            "value": "true"
          },
          {
            "type": "attributeEquals",
            "selector": ".governance-failures",
            "name": "hidden",
            "value": ""
          }
        ],
        "timeoutMs": 5000
      }
    ]
  }
}

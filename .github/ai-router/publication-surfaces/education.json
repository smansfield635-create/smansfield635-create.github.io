{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "education",
  "description": "Diamond Gate Bridge Education learner chamber at /products/education/: six learner-facing journey chapters plus the English adaptive-placement demo flow.",
  "checks": [
    {
      "path": "/products/education/index.html",
      "includes": [
        "EDUCATION_COHERISCOPE_PATTERN_PLACEMENT_DEMO_v1",
        "English Fluency Accelerator",
        "Possibility",
        "Understanding",
        "Action",
        "Progress",
        "Independence",
        "Achievement",
        "Learn",
        "Practice",
        "Check",
        "Back to the Journey",
        "Start the Demo",
        "NATIVE_SUPPORTED",
        "BILINGUAL_BRIDGED",
        "TARGET_DOMINANT",
        "TARGET_ONLY",
        "ABOVE_PHASE_1",
        "demo_entry_point",
        "data-no-backend=\"true\"",
        "data-no-persistence=\"true\""
      ],
      "excludes": [
        "Public Face",
        "Technical Face",
        "Education architecture standards",
        "Engineering detail",
        "data-demo-language-spanish=\"available\"",
        "data-demo-language-chinese=\"available\"",
        "data-speech-measurement=\"true\"",
        "data-listening-measurement=\"true\""
      ]
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/products/education/",
    "timeoutMs": 15000,
    "readySelector": "html[data-education-demo-ready=\"true\"]",
    "binding": {
      "mode": "direct-document",
      "path": "/products/education/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [],
    "interactions": [
      {
        "name": "Outer carousel advances to Understanding",
        "action": {
          "type": "click",
          "selector": "[data-edu-index=\"1\"]"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "[data-edu-live]",
            "value": "Understanding"
          },
          {
            "type": "textContains",
            "selector": ".edu-standard-card[data-active=\"true\"] .edu-standard-title",
            "value": "Build More Than You Memorize"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Selected chapter opens in shared learning field",
        "action": {
          "type": "click",
          "selector": ".edu-standard-card[data-active=\"true\"] [data-edu-inspect]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "[data-edu-carousel]",
            "name": "data-inspecting",
            "value": "true"
          },
          {
            "type": "exists",
            "selector": ".edu-standard-card[data-active=\"true\"][data-inspecting=\"true\"]"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Practice lens changes independently",
        "action": {
          "type": "click",
          "selector": ".edu-standard-card[data-active=\"true\"] [data-edu-lens=\"engineering\"]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": ".edu-standard-card[data-active=\"true\"] [data-edu-lens=\"engineering\"]",
            "name": "aria-selected",
            "value": "true"
          },
          {
            "type": "textContains",
            "selector": ".edu-standard-card[data-active=\"true\"] [data-edu-cell]",
            "value": "See how it works"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Return to journey preserves selected chapter",
        "action": {
          "type": "click",
          "selector": ".edu-standard-card[data-active=\"true\"] [data-edu-return]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "[data-edu-carousel]",
            "name": "data-inspecting",
            "value": "false"
          },
          {
            "type": "textContains",
            "selector": "[data-edu-live]",
            "value": "Understanding"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Start Demo opens language selection",
        "action": {
          "type": "click",
          "selector": "[data-start-demo]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#demo-shell:not([hidden])"
          },
          {
            "type": "textContains",
            "selector": "#demo-title",
            "value": "Choose a language"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "English enters learner intake on same live module",
        "action": {
          "type": "click",
          "selector": "[data-language=\"English\"]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "[data-demo-stage=\"intake\"]:not([hidden])"
          },
          {
            "type": "textContains",
            "selector": "[data-demo-stage=\"intake\"]",
            "value": "Tell us where English feels comfortable today."
          }
        ],
        "timeoutMs": 5000
      }
    ]
  }
}

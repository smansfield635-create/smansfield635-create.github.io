{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "h-earth-simple",
  "description": "Canonical H-Earth prepared woodland scene and available controls; input-confirmed entry and physical-device smoothness remain separate acceptance.",
  "checks": [
    {
      "path": "/showroom/globe/h-earth/index.html",
      "includes": [
        "<title>H-Earth · Live Interactive World</title>",
        "id=\"h-earth-functional-landscape-route\"",
        "data-run8e-ready=\"false\"",
        "./vegetation-prototype/route.js?rev=gen2795-performance-v1",
        "type=\"importmap\""
      ],
      "excludes": [
        "public-live-gpu-integration.run8e-r3e.receipt.js",
        "raw.githack.com"
      ]
    },
    {
      "path": "/showroom/globe/h-earth/vegetation-prototype/route.js",
      "includes": [
        "const diagnosticReplay=location.pathname.endsWith('/vegetation-prototype.html');",
        "if(diagnosticReplay){",
        "vegetationStrategy:'SINGLE_OWNER_WOODLAND_V1'",
        "mode:diagnosticReplay?'diagnostic-replay':'manual-public'",
        "root.dataset.singleOwnerPrototype='controls-test';loader.enableControls(intake.getNavigationState());",
        "assert(entryOwner.installedRootCount>0&&controlIds.length>0,'EMPTY_INSTALLED_CONTROL');",
        "assert(entryOwner.selectedFineRoots>0&&entryOwner.drawCallCount>0,'EMPTY_FINE_SUBMISSION');",
        "assert(entryOwner.coarseRootCount>0&&entryOwner.coarseTiles>0,'COARSE_COVERAGE_MISSING');",
        "assertStableObservation(entry,controlIds);",
        "root.dataset.run8eError='true';"
      ],
      "excludes": []
    },
    {
      "path": "/showroom/globe/h-earth/render/vegetation-single-owner.prototype.v1.js",
      "includes": [
        "createSingleOwnerVegetation",
        "planImmutableTiles"
      ],
      "excludes": []
    },
    {
      "path": "/showroom/globe/h-earth/vegetation-prototype/loading-screen.v1.js",
      "includes": [
        "proposal?.accepted!==true",
        "firstInput.sequence!==state.sequence",
        "firstInput.pose!==pose(state)",
        "frame?.navigationSequence!==state.sequence",
        "receipt.nextAnimationFrameOpportunityMilliseconds=elapsed();mode='ready';",
        "if(mode!=='ready'||button.disabled)return;",
        "onEnter();"
      ],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/showroom/globe/h-earth/",
    "timeoutMs": 120000,
    "readyAttribute": {
      "selector": "#h-earth-functional-landscape-route",
      "name": "data-single-owner-prototype",
      "contains": "controls-test"
    },
    "binding": {
      "mode": "direct-document",
      "path": "/showroom/globe/h-earth/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [],
    "interactions": [
      {
        "name": "Prepared woodland controls await genuine input before entry",
        "action": {
          "type": "click",
          "selector": "#h-earth-functional-landscape-canvas"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "#h-earth-functional-landscape-route",
            "name": "data-single-owner-prototype",
            "value": "controls-test"
          },
          {
            "type": "attributeEquals",
            "selector": "#h-earth-functional-landscape-route",
            "name": "data-world-first-frame-ready",
            "value": "true"
          },
          {
            "type": "attributeEquals",
            "selector": "#h-earth-functional-landscape-route",
            "name": "data-run8e-ready",
            "value": "false"
          },
          {
            "type": "attributeEquals",
            "selector": "#h-earth-loading-screen",
            "name": "data-mode",
            "value": "test"
          },
          {
            "type": "exists",
            "selector": "#h-earth-loading-screen button[disabled]"
          },
          {
            "type": "exists",
            "selector": "#h-earth-functional-landscape-route:not([data-run8e-error=\"true\"])"
          },
          {
            "type": "textContains",
            "selector": "#prototype-status",
            "value": "Test controls on the landscape to unlock Enter H-Earth"
          }
        ],
        "timeoutMs": 15000
      }
    ]
  }
}

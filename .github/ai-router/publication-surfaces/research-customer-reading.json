{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "research-customer-reading",
  "description": "Paired industry and homeowner field study; exact-head page proof with preserved original records.",
  "checks": [
    {
      "path": "/research/testimonials/index.html",
      "includes": [
        "100 field-study entries",
        "id=\"study-source-note\"",
        "id=\"field-list\"",
        "id=\"topic-results\"",
        "review:false,guide:true",
        "id:100,name:\"Susan Finehout\"",
        "Browse 100 numbered entries",
        "<strong>100</strong><span>residential sales in the original study</span>",
        "id=\"chapter-questions\"",
        "id=\"chapter-details\"",
        "id=\"chapter-records\"",
        "name=\"study-chapter\"",
        "Leaves, overflowing gutters, damaged wood, crumbling foundations, difficult corners: every home brings different questions."
      ],
      "excludes": [
        "The 87 field notes",
        "surviving notes to explore",
        "What my first 100 sales taught me",
        "Entries 14–100 survive; entries 1–13 are unavailable.",
        "<strong>100</strong><span>organized study entries to explore</span>",
        "class=\"study-chapter\" id=\"chapter-details\" open",
        "Leaves, overflowing gutters, damaged wood, difficult corners: every home brings different questions."
      ]
    },
    {
      "path": "/research/industry-context/index.html",
      "includes": [
        "100 browsable entries",
        "Question to consider:",
        "id=\"companies\"",
        "/research/testimonials/"
      ],
      "excludes": [
        "For the homeowner:",
        "For the customer:",
        "What my first 100 sales taught me"
      ]
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/research/testimonials/",
    "timeoutMs": 15000,
    "readySelector": "#full-notes",
    "binding": {
      "mode": "direct-document",
      "path": "/research/testimonials/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "interactions": [
      {
        "name": "Open questions chapter",
        "action": {
          "type": "click",
          "selector": "#chapter-questions > summary"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#chapter-questions[open]"
          },
          {
            "type": "exists",
            "selector": "#concerns .topic-grid"
          }
        ]
      },
      {
        "name": "Question filter responds",
        "action": {
          "type": "click",
          "selector": "[data-topic=\"clog\"]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "[data-topic=\"clog\"]",
            "name": "aria-pressed",
            "value": "true"
          },
          {
            "type": "exists",
            "selector": "#topic-results:not([hidden])"
          }
        ]
      },
      {
        "name": "Open details chapter closes questions",
        "action": {
          "type": "click",
          "selector": "#chapter-details > summary"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#chapter-details[open]"
          },
          {
            "type": "exists",
            "selector": "#chapter-questions:not([open])"
          },
          {
            "type": "exists",
            "selector": "#promises .group > details"
          }
        ]
      },
      {
        "name": "Nested warranty dropdown works",
        "action": {
          "type": "click",
          "selector": "#promises .group > details > summary"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#promises .group > details[open]"
          }
        ]
      },
      {
        "name": "Open field notes chapter closes details",
        "action": {
          "type": "click",
          "selector": "#chapter-records > summary"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#chapter-records[open]"
          },
          {
            "type": "exists",
            "selector": "#chapter-details:not([open])"
          },
          {
            "type": "exists",
            "selector": "#full-notes"
          }
        ]
      },
      {
        "name": "Open 100-entry original index",
        "action": {
          "type": "click",
          "selector": "#full-notes > summary"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#full-notes[open]"
          },
          {
            "type": "exists",
            "selector": "#field-list .record-group"
          }
        ]
      }
    ]
  }
}

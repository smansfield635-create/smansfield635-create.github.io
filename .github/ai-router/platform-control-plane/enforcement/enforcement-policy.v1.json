    "explicitMergeAuthorityRequired": true,
    "silentBypassAllowed": false
  },
  "governingLaws": [
    "SHADOW_DECISION_DOES_NOT_ENFORCE",
    "LIVE_REPOSITORY_SETTINGS_CHANGE_REQUIRES_SEPARATE_SYNCHRONIZATION_AUTHORITY",
    "ACTIVE_TRANSACTIONS_MAY_NOT_BE_RE_GOVERNED_RETROACTIVELY",
    "BYPASS_REQUIRES_EXPLICIT_SEPARATE_AUTHORITY",
    "MISSING_REQUIRED_CHECK_FAILS_SHADOW_CLOSED",
    "UNPROTECTED_MAIN_FAILS_SHADOW_CLOSED"
  ],
  "authorityBoundary": {
    "liveActivationAllowed": false,
    "repositorySettingsMutationAllowed": false,
    "branchProtectionMutationAllowed": false,
    "rulesetMutationAllowed": false,
    "authorityCreated": false,
    "mergeAuthorityCreated": false,
    "hEarthAuthorityCreated": false,
    "lawsAuthorityCreated": false
  }

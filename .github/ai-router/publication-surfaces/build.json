{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "build",
  "description": "Build spatial capability and pricing instruments, plus explicitly opened project companion.",
  "checks": [
    {
      "path": "/build/index.html",
      "includes": [
        "Build something worth returning to.",
        "A website used to be an address. Now it can be a destination.",
        "data-spatial-instrument=\"capabilities\"",
        "data-spatial-instrument=\"pricing\"",
        "Custom Website",
        "Interactive Experience",
        "Browser Tool",
        "Advanced System",
        "Custom Essential",
        "Custom Interactive",
        "Custom Systems",
        "From $750",
        "From $1,750",
        "Scoped after consultation",
        "Generation 2084 environmental refinement",
        "/assets/build/build-companion.js?v=1",
        "/assets/build/build-companion.css?v=1"
      ],
      "excludes": []
    },
    {
      "path": "/build/intake/index.html",
      "includes": [
        "data-open-build-companion",
        "/assets/build/build-companion.js?v=1"
      ],
      "excludes": [
        "wizard-progress"
      ]
    },
    {
      "path": "/assets/build/build-companion.js",
      "includes": [
        "dgb-build-companion-v2",
        "build-matrix.v2.json",
        "build-engine.mjs",
        "Close project conversation",
        "geodiametrics@gmail.com",
        "dialog.showModal()",
        "Nothing is sent automatically."
      ],
      "excludes": [
        "businessMatrix",
        "Request catering",
        "Find hours and directions"
      ]
    },
    {
      "path": "/assets/build/build-companion.css",
      "includes": [
        ".build-companion:not([open])",
        ".bc-header",
        ".bc-close"
      ],
      "excludes": []
    },
    {
      "path": "/assets/build/build-engine.mjs",
      "includes": [
        "activeNodes",
        "pruneAnswers",
        "pruneDone",
        "synthesizeBrief",
        "emailDraft"
      ],
      "excludes": [
        "categories['Help me decide']"
      ]
    },
    {
      "path": "/assets/build/build-matrix.v2.json",
      "includes": [
        "BUILD_COMPANION_MATRIX_v2",
        "Who does this website need to serve first?",
        "What should the website accomplish for them and for you?",
        "Accept catering inquiries",
        "Present the catalog only",
        "Complete purchases on the site",
        "What job or workflow should the application help its users complete?",
        "What place, world, product, or idea should people explore?",
        "What is the current website address?"
      ],
      "excludes": [
        "Request a quote",
        "Book a service",
        "Find hours and directions"
      ]
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/build/",
    "timeoutMs": 45000,
    "readySelector": "[data-spatial-instrument=\"capabilities\"][data-enhanced=\"true\"]",
    "binding": {
      "mode": "direct-document",
      "path": "/build/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [],
    "interactions": [
      {
        "name": "Capability orbit advances",
        "action": {
          "type": "click",
          "selector": "[data-spatial-instrument=\"capabilities\"] [data-orbit-next]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "[data-spatial-instrument=\"capabilities\"]",
            "name": "data-orbit-index",
            "value": "1"
          },
          {
            "type": "textContains",
            "selector": "[data-spatial-instrument=\"capabilities\"] [data-instrument-status]",
            "value": "Interactive Experience"
          }
        ]
      },
      {
        "name": "Pricing orbit advances independently",
        "action": {
          "type": "click",
          "selector": "[data-spatial-instrument=\"pricing\"] [data-orbit-next]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "[data-spatial-instrument=\"pricing\"]",
            "name": "data-orbit-index",
            "value": "1"
          },
          {
            "type": "textContains",
            "selector": "[data-spatial-instrument=\"pricing\"] [data-instrument-status]",
            "value": "Custom Interactive"
          },
          {
            "type": "attributeEquals",
            "selector": "[data-spatial-instrument=\"capabilities\"]",
            "name": "data-orbit-index",
            "value": "1"
          }
        ]
      },
      {
        "name": "Selected pricing object opens its reader",
        "action": {
          "type": "click",
          "selector": "[data-spatial-instrument=\"pricing\"] [data-orbit-object][data-front=\"true\"]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "[data-spatial-instrument=\"pricing\"]",
            "name": "data-depth-state",
            "value": "reader"
          },
          {
            "type": "exists",
            "selector": "[data-spatial-instrument=\"pricing\"] [data-reader-index=\"1\"] [data-turn-card]"
          }
        ]
      },
      {
        "name": "Pricing reader turns to terms",
        "action": {
          "type": "click",
          "selector": "[data-spatial-instrument=\"pricing\"] [data-reader-index=\"1\"] [data-turn-toggle]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "[data-spatial-instrument=\"pricing\"] [data-reader-index=\"1\"] [data-turn-card]",
            "name": "data-face",
            "value": "back"
          },
          {
            "type": "textContains",
            "selector": "[data-spatial-instrument=\"pricing\"] [data-reader-index=\"1\"] [data-turn-status]",
            "value": "Price & terms"
          }
        ]
      },
      {
        "name": "Project conversation opens on selection",
        "action": {
          "type": "click",
          "selector": ".hero a[href=\"/build/intake/\"]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#build-companion[open] .bc-close"
          },
          {
            "type": "textContains",
            "selector": ".bc-log",
            "value": "What would you like to bring to life?"
          }
        ]
      },
      {
        "name": "Project conversation closes",
        "action": {
          "type": "click",
          "selector": "#build-companion .bc-close"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#build-companion:not([open])"
          }
        ]
      }
    ]
  }
}

        "ArrowLeft",
        "ArrowRight",
        "pointerdown",
        "aria-selected",
        "toggleAttribute(\"inert\"",
        "root.dataset.carouselReady = \"true\""
      ],
      "excludes": ["compass.carousel.js"]
    },
    {
      "path": "/products/archcoin/carousel.css",
      "includes": [

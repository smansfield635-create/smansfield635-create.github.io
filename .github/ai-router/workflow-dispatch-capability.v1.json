{
  "schema": "AI_ENTRY_WORKFLOW_DISPATCH_CAPABILITY_v1",
  "status": "ACTIVE_FAIL_CLOSED",
  "repository": "smansfield635-create/smansfield635-create.github.io",
  "purpose": "Provide a continuity-safe native GitHub workflow_dispatch path when the connected GitHub tool does not expose workflow dispatch directly.",
  "preferredTransport": "DIRECT_CONNECTED_GITHUB_WORKFLOW_DISPATCH",
  "fallbackTransport": "SAME_REPOSITORY_PR_NATIVE_WORKFLOW_DISPATCH_BRIDGE",
  "requestBranchPrefix": "ai-dispatch-request-",
  "requestPath": ".github/ai-entry/workflow-dispatch-request.json",
  "receiptBranch": "ai-dispatch-receipts",
  "receiptPathTemplate": ".github/ai-entry/receipts/<requestId>.json",
  "bridgeWorkflow": ".github/workflows/ai-entry-workflow-dispatch-bridge.yml",
  "bridgeRuntime": "tools/ai-entry-workflow-dispatch-bridge.mjs",
  "transportPullRequest": {
    "base": "main",
    "headPrefix": "ai-dispatch-request-",
    "titlePrefix": "AI Dispatch:",
    "sameRepositoryRequired": true,
    "autoCloseOnSuccess": true,
    "autoDeleteHeadBranchOnSuccess": true,
    "mergeAllowed": false
  },
  "capabilities": {
    "PAGES_EXACT_HEAD_DEPLOY": {
      "workflow": "pages-exact-head-deploy-v3.yml",
      "ref": "main",
      "inputPolicy": {
        "target_sha": {"source": "CURRENT_MAIN_SHA","userOverrideAllowed": false},
        "surface_id": {"source": "REQUEST","required": true,"userOverrideAllowed": true}
      }
    },
    "H_EARTH_STAGE1_COST_QUALIFY": {
      "workflow": "h-earth-stage1-cost-qualify.yml",
      "ref": "main",
      "inputPolicy": {
        "baseline_sha": {"source": "REQUEST","required": true,"userOverrideAllowed": true},
        "candidate_sha": {"source": "REQUEST","required": true,"userOverrideAllowed": true}
      }
    },
    "H_EARTH_STAGE1_INSPECTION_PUBLISH": {
      "workflow": "h-earth-stage1-inspection-publish.yml",
      "ref": "main",
      "inputPolicy": {
        "target_sha": {"source": "CURRENT_MAIN_SHA","userOverrideAllowed": false}
      }
    },
    "H_EARTH_STAGE1_MOBILE_INTERACTION_QUALIFY": {
      "workflow": "h-earth-stage1-mobile-interaction-qualify.yml",
      "ref": "main",
      "inputPolicy": {
        "candidate_sha": {"source": "REQUEST","required": true,"userOverrideAllowed": true}
      }
    }
  },
  "continuity": {
    "freshRequestBranchFromCurrentMainRequired": true,
    "requestCommitParentMustEqualCurrentMain": true,
    "dispatchRunIdMustBeRecovered": true,
    "receiptMustBindRequestCommitMainHeadWorkflowRefInputsAndRunId": true,
    "receiptResult": "NATIVE_WORKFLOW_DISPATCH_ACCEPTED_AND_RUN_RESOLVED",
    "directConnectorDispatchPreferredWhenAvailable": true,
    "fallbackMayNotCreateGenericCommandAuthority": true,
    "transportPullRequestIsExecutionCarrierOnly": true,
    "transportPullRequestMayNeverBeMerged": true,
    "successfulTransportLeavesNoRequestBranch": true
  },
  "rules": [
    "FAIL_CLOSED_ON_UNKNOWN_CAPABILITY",
    "FAIL_CLOSED_ON_STALE_REQUEST_BRANCH",
    "FAIL_CLOSED_ON_NONLOCAL_TRANSPORT_PR",
    "FAIL_CLOSED_ON_UNDECLARED_INPUT",
    "FAIL_CLOSED_IF_NATIVE_DISPATCH_IS_NOT_ACCEPTED",
    "FAIL_CLOSED_IF_DISPATCHED_RUN_ID_CANNOT_BE_RESOLVED",
    "NO_SHELL_OR_GENERIC_COMMAND_INPUT",
    "NO_ARBITRARY_WORKFLOW_PATH",
    "NO_AUTHORITY_EXPANSION_BY_REQUEST",
    "TRANSPORT_PULL_REQUEST_MUST_NOT_BE_MERGED",
    "DIRECT_NATIVE_CONNECTOR_DISPATCH_SUPERSEDES_FALLBACK_WHEN_AVAILABLE"
  ]
}

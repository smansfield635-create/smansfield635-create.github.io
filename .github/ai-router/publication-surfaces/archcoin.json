      "includes": ["rel=\"canonical\" href=\"../#overview\"", "content=\"0; url=../#overview\""],
      "excludes": []
    },
    {
      "path": "/products/archcoin/payable/engineering/index.html",
      "includes": ["rel=\"canonical\" href=\"../#engineering\"", "content=\"0; url=../#engineering\""],
      "excludes": []
    },
    {
      "path": "/products/archcoin/payable/platform/index.html",
      "includes": ["rel=\"canonical\" href=\"../#platform\"", "content=\"0; url=../#platform\""],
      "excludes": []
    },
    {
      "path": "/products/archcoin/payable/governance/index.html",
      "includes": ["rel=\"canonical\" href=\"../#governance\"", "content=\"0; url=../#governance\""],

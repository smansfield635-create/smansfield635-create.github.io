        "href=\"https://etherscan.io/tx/0xd932dceef5f3085f7d42e6ac25a44c6675364156261305b1fd650899c70a3ea0\""
      ],
      "excludes": [
        "0x0000000000000000000000000000000000000000",
        "Sepolia pending",
        "not represented here as a deployed cryptocurrency",
        "Mainnet remains later",
        "not a frozen Sepolia or mainnet issuance quantity",
        "no recipient wallet has been selected"
      ]
    },
    {
      "path": "/products/archcoin/receivable/index.html",

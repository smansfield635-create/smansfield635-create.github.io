{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ESTATE_DIAGNOSTIC_RECEIPT_PROFILE_SCHEMA_v1",
  "title": "Estate Diagnostic Receipt Profile v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "profile_version",
    "receipt_id",
    "instrument",
    "producer",
    "target",
    "execution",
    "input_refs",
    "evidence",
    "absence",
    "result",
    "direction",
    "claim_ceiling",
    "parent_receipt_digests",
    "archive_locator"
  ],
  "properties": {
    "profile": {
      "const": "ESTATE_DIAGNOSTIC_RECEIPT_PROFILE_v1"
    },
    "profile_version": {
      "const": "1.0.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "definition_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "definition_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "instrument",
            "workflow",
            "browser",
            "human",
            "other"
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "identity"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_sha",
        "deployment_sha",
        "invocation_id",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "repository_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "deployment_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "invocation_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "finished_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "evidence": {
      "type": "array"
    },
    "absence": {
      "type": "array"
    },
    "result": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "parent_receipt_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "archive_locator": {
      "type": [
        "string",
        "null"
      ]
    },
    "legacy_receipt": {
      "type": [
        "object",
        "null"
      ]
    },
    "cycle_root": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}

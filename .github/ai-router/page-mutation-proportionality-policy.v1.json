{
  "schema": "PAGE_MUTATION_PROPORTIONALITY_POLICY_v1",
  "policyId": "PAGE_MUTATION_PROPORTIONALITY_AND_STATIC_EDITORIAL_BYPASS_v1",
  "status": "ACTIVE_WHEN_ROUTER_WRAPPER_PRESENT",
  "governingRule": "CANONICAL_ADMITTED_LOCKED_IS_REQUIRED_FOR_WEBSITE_RUNTIME_BEHAVIOR_AUTHORITY_CONTROL_PLANE_OR_AMBIGUOUS_PAGE_MUTATIONS_NOT_FOR_DETERMINISTICALLY_CLASSIFIED_STATIC_EDITORIAL_MICRO_OR_BOUNDED_NON_AUTHORITATIVE_PAGE_RELEASE_MUTATIONS",
  "instrument": "PAGE_MUTATION_CLASSIFICATION_INSTRUMENT_v1",
  "router": "tools/repository-ai-entry-router.mjs",
  "legacyGovernedRouter": "tools/repository-ai-entry-router.v3-legacy.mjs",
  "staticVerifier": "tools/static-editorial-micro-verifier.v1.mjs",
  "classes": {
    "STATIC_EDITORIAL_MICRO": {
      "canonicalAdmissionRequired": false,
      "pageExcellenceRequired": false,
      "requiredProofs": ["EXACT_HEAD", "DECLARED_PATHS_ONLY", "NO_EXECUTABLE_RUNTIME_DELTA", "NO_UNRELATED_DIFF"],
      "examples": ["TEXT_COPY", "INSTRUCTIONS", "TYPO", "LABEL", "HEADLINE", "BOUNDED_STATIC_ORDER", "SPACING", "TYPOGRAPHY", "COLOR"]
    },
    "BOUNDED_PAGE_RELEASE": {
      "canonicalAdmissionRequired": false,
      "pageExcellenceRequired": false,
      "purpose": "BOUNDED_NON_AUTHORITATIVE_PRESENTATION_RELEASE",
      "cinematicPresentationAllowed": true,
      "cinematicRequirements": [
        "EXPLICIT_NON_INTERACTIVE_PRESENTATION_INTENT",
        "EXECUTABLE_PATHS_CINEMATIC_SCOPED",
        "NO_CONTROL_OR_AUTHORITY_PATH",
        "NO_WEBSITE_NAVIGATION_ROUTING_CONTROLLER_OR_APPLICATION_STATE_AUTHORITY",
        "AMBIGUITY_FAILS_CLOSED"
      ],
      "requiredProofs": [
        "EXACT_HEAD",
        "DECLARED_PATHS_ONLY",
        "NO_NAVIGATION_DELTA",
        "NO_APPLICATION_STATE_AUTHORITY_DELTA",
        "NO_SHARED_DOM_AUTHORITY_DELTA",
        "NO_ANALYTICS_DELTA",
        "IDEMPOTENT_PRESENTATION_RESTORATION",
        "NO_UNRELATED_DIFF"
      ],
      "examples": ["NON_INTERACTIVE_CINEMATIC_PRESENTATION", "BOUNDED_FILM_PLAYBACK"]
    },
    "RUNTIME_OR_AUTHORITY": {
      "canonicalAdmissionRequired": true,
      "pageExcellenceRequiredWhenPageOperation": true,
      "includes": [
        "GENERIC_OR_UNSCOPED_EXECUTABLE_FILE_CHANGE",
        "WEBSITE_RUNTIME_BEHAVIOR",
        "EVENT_HANDLER_WITH_WEBSITE_AUTHORITY",
        "NAVIGATION",
        "SHARED_STATE_MACHINE",
        "ROUTING",
        "GESTURE",
        "DOM_AUTHORITY",
        "CONTROL_PLANE",
        "GOVERNANCE",
        "AMBIGUOUS_MUTATION"
      ]
    }
  },
  "ambiguityDisposition": "RUNTIME_OR_AUTHORITY",
  "mixedPathDisposition": "RUNTIME_OR_AUTHORITY",
  "runtimeAuthorityCannotBeCreatedByProportionalClassification": true,
  "boundedPageReleaseCannotCreateWebsiteRuntimeAuthority": true,
  "staticClassificationCannotBypassProjectRegistration": true,
  "boundedPageReleaseCannotBypassProjectRegistration": true,
  "proportionalClassificationCannotBypassExactDiffVerification": true,
  "validationRule": "SELF_TEST_AND_EXACT_CANDIDATE_VERIFIER_EVIDENCE_VALIDATE_IMPLEMENTATION_BUT_DO_NOT_CREATE_WEBSITE_RUNTIME_AUTHORITY",
  "authorityEffect": "PROPORTIONAL_ROUTING_ONLY"
}

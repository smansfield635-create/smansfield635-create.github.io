{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "consider-the-energy",
  "description": "Consider the Energy Community exact-head publication verification for the current production image hero. Static checks bind the page to the production image loader, intrinsic image sizing, collapsed inherited stage chrome, the exact image-source pointer, and the shared estate cosmic background. Generic headless runtime verifies the environment-independent shared decorative canvas and error-free page load; final authoritative live exact-head verification remains required for publication truth.",
  "checks": [
    {
      "path": "/campaigns/consider-the-energy/index.html",
      "includes": [
        "data-route=\"/campaigns/consider-the-energy/\"",
        "data-community-lifecycle-mount></figure>",
        "/assets/dgb-estate-cosmos.js",
        "/campaigns/consider-the-energy/community-logo.production.js?v=20260916-topology-production-v1",
        "Consider the Community with Consider the Energy."
      ],
      "excludes": [
        "data-community-lifecycle-fallback",
        "/campaigns/consider-the-energy/community-lifecycle3d.js?v=20260914-gen2265-eight-state-lifecycle-v2",
        "community-lifecycle3d.js?v=20260914-stage-final"
      ]
    },
    {
      "path": "/campaigns/consider-the-energy/community-logo.production.js",
      "includes": [
        "fetch('./community-image-source.txt', { cache: 'no-store' })",
        "image.alt = 'Consider the Energy tree emblem'",
        "image.style.width = '100%'",
        "image.style.height = 'auto'",
        "image.style.maxHeight = 'none'",
        "image.style.objectFit = 'contain'",
        "mount.style.minHeight = '0'",
        "mount.style.padding = '0'",
        "mount.style.background = 'none'",
        "mount.style.borderLeft = '0'",
        "mount.replaceChildren(image)"
      ],
      "excludes": [
        "image.style.height = '100%'",
        "image.style.maxHeight = '36rem'"
      ]
    },
    {
      "path": "/campaigns/consider-the-energy/community-image-source.txt",
      "includes": [
        "https://drive.google.com/thumbnail?id=1ex4LMF-WW9gLmeVeernhEEl4X1q5OzHX&sz=w1600"
      ],
      "excludes": []
    },
    {
      "path": "/assets/dgb-estate-cosmos.js",
      "includes": [
        "DGB_ESTATE_COSMIC_CONTINUITY_v1",
        "pointerEvents: \"none\"",
        "mobileDprCap: 1",
        "desktopDprCap: 1.25",
        "visibilitychange",
        "prefers-reduced-motion: reduce"
      ],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/campaigns/consider-the-energy/",
    "timeoutMs": 15000,
    "readySelector": "#dgb-estate-cosmos[data-dgb-estate-cosmos-status=\"available\"]",
    "binding": {
      "mode": "direct-document",
      "path": "/campaigns/consider-the-energy/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": []
  }
}

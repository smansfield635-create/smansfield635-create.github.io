  "githubActionsExecution": {
    "backendId": "GITHUB_ACTIONS_CLEAN_EXECUTION",
    "workflow": ".github/workflows/methods-information-benchmark-pre-role-bootstrap-v1.yml",
    "artifact": "methods-information-benchmark-pre-role-bootstrap-v1-evidence"
  },
  "stoppingRules": [
    "ORIGIN_SEED_MISSING_OR_HASH_MISMATCH",
    "ROUTER_DISPOSITION_NOT_PASS",
    "BUILDER_AND_VERIFIER_EXECUTION_HOLDER_COLLISION",
    "TOPOLOGY_OR_FINGERPRINT_DIVERGENCE",
    "OPEN_FATAL_FINDING",
    "USER_ACCEPTANCE_RECEIPT_MISSING",
    "STALE_ASSIGNMENT_LEDGER_HEAD"
  ]

{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "nine-summits-universe",
  "description": "Nine Summits Universe live source smoke: nine teaching relationships plus Peace-first cinematic selection. These assertions do not certify artistic quality or the complete journey.",
  "checks": [
    {
      "path": "/nine-summits/universe/index.html",
      "includes": [
        "Nine summits. One heart.",
        "Back to Compass",
        "/assets/compass/compass.orbit-physics.js",
        "id=\"reflection\"",
        "data-summit=\"8\"",
        "One choice. One path.",
        "Choose love.",
        "id=\"summit-teaching\""
      ],
      "excludes": []
    },
    {
      "path": "/nine-summits/universe/universe.motion.js",
      "includes": [
        "DGB_COMPASS_ORBIT_PHYSICS",
        "admitHEarthPrimitiveBatch",
        "Joy begins with noticing.",
        "DGB_UNIVERSE",
        "const teachings"
      ],
      "excludes": []
    },
    {
      "path": "/assets/compass/compass.orbit-physics.js",
      "includes": [
        "DGB_COMPASS_ORBIT_PHYSICS",
        "constellationReleaseQuaternionAt",
        "releaseParameters"
      ],
      "excludes": []
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/nine-summits/universe/",
    "timeoutMs": 30000,
    "readySelector": "#universe-scene.ready",
    "binding": {
      "mode": "direct-document",
      "path": "/nine-summits/universe/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [
      "favicon.ico"
    ],
    "interactions": [
      {
        "name": "Begin with Peace from primary hero",
        "action": {
          "type": "click",
          "selector": "#explore-worlds"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#universe-scene[data-stage='approach'], #universe-scene[data-stage='encounter']"
          },
          {
            "type": "textContains",
            "selector": "#scene-note",
            "value": "Peace"
          }
        ],
        "timeoutMs": 7500
      },
      {
        "name": "Open nine summits list",
        "action": {
          "type": "click",
          "selector": "#path-list summary"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#path-list[open]"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Switch to Gratitude and Joy",
        "action": {
          "type": "click",
          "selector": "[data-summit=\"0\"]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#universe-scene[data-stage='approach'], #universe-scene[data-stage='encounter']"
          },
          {
            "type": "textContains",
            "selector": "#scene-note",
            "value": "Gratitude"
          }
        ],
        "timeoutMs": 7500
      },
      {
        "name": "Switch to Generosity and Love",
        "action": {
          "type": "click",
          "selector": "[data-summit=\"1\"]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#universe-scene[data-stage='approach'], #universe-scene[data-stage='encounter']"
          },
          {
            "type": "textContains",
            "selector": "#scene-note",
            "value": "Generosity"
          }
        ],
        "timeoutMs": 7500
      }
    ]
  }
}

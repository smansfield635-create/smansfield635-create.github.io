{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "education",
  "description": "Diamond Gate Bridge Education learner chamber at /products/education/: continuous six-card spatial learner journey with EN/ES/ZH help-language support plus the English adaptive-placement demo flow.",
  "checks": [
    {
      "path": "/products/education/index.html",
      "includes": [
        "EDUCATION_COHERISCOPE_PATTERN_PLACEMENT_DEMO_v1",
        "English Fluency Accelerator",
        "Possibility",
        "Understanding",
        "Action",
        "Progress",
        "Independence",
        "Achievement",
        "data-help-language=\"en\"",
        "data-help-language=\"es\"",
        "data-help-language=\"zh\"",
        "data-chamber-action",
        "data-chamber-practice-action",
        "data-chamber-check-action",
        "pointermove",
        "NATIVE_SUPPORTED",
        "BILINGUAL_BRIDGED",
        "TARGET_DOMINANT",
        "TARGET_ONLY",
        "ABOVE_PHASE_1",
        "demo_entry_point",
        "data-no-backend=\"true\"",
        "data-no-persistence=\"true\""
      ],
      "excludes": [
        "Public Face",
        "Technical Face",
        "Education architecture standards",
        "Engineering detail",
        "data-speech-measurement=\"true\"",
        "data-listening-measurement=\"true\"",
        "data-edu-tabs",
        "The target-language curriculum is not yet available in this demo."
      ]
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/products/education/",
    "timeoutMs": 15000,
    "readySelector": "html[data-education-demo-ready=\"true\"]",
    "binding": {
      "mode": "direct-document",
      "path": "/products/education/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [],
    "interactions": [
      {
        "name": "Neighboring card advances to Understanding",
        "action": {
          "type": "click",
          "selector": ".edu-standard-card[data-card-index=\"1\"]"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "[data-edu-live]",
            "value": "Understanding"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Selected card turns to learning back",
        "action": {
          "type": "click",
          "selector": ".edu-standard-card[data-active=\"true\"] [data-chamber-action]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": ".edu-standard-card[data-active=\"true\"]",
            "name": "data-face",
            "value": "back"
          },
          {
            "type": "exists",
            "selector": ".edu-standard-card[data-active=\"true\"] [data-chamber-learn]"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Practice records learner action",
        "action": {
          "type": "click",
          "selector": ".edu-standard-card[data-active=\"true\"] [data-chamber-practice-action]"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": ".edu-standard-card[data-active=\"true\"] [data-chamber-feedback]",
            "value": "Correct"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Check consumes learner action",
        "action": {
          "type": "click",
          "selector": ".edu-standard-card[data-active=\"true\"] [data-chamber-check-action]"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": ".edu-standard-card[data-active=\"true\"] [data-chamber-feedback]",
            "value": "Correct"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Back returns selected card to front",
        "action": {
          "type": "click",
          "selector": ".edu-standard-card[data-active=\"true\"] [data-chamber-back]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": ".edu-standard-card[data-active=\"true\"]",
            "name": "data-face",
            "value": "front"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Start Demo opens language selection",
        "action": {
          "type": "click",
          "selector": "[data-start-demo]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#demo-shell:not([hidden])"
          }
        ],
        "timeoutMs": 5000
      },
      {
        "name": "Spanish help enters learner intake",
        "action": {
          "type": "click",
          "selector": "[data-help-language=\"es\"]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "[data-demo-stage=\"intake\"]:not([hidden])"
          },
          {
            "type": "attributeEquals",
            "selector": "html",
            "name": "lang",
            "value": "es"
          }
        ],
        "timeoutMs": 5000
      }
    ]
  }
}

    "TRANSPORTABILITY_DOES_NOT_CREATE_ADMISSIBILITY_PRODUCT_SEMANTIC_SCIENTIFIC_MERGE_DEPLOYMENT_RELEASE_OR_PUBLICATION_AUTHORITY",
    "PUBLIC_EVIDENCE_MAY_PROJECT_ONLY_SEPARATELY_AUTHORIZED_SANITIZED_FACTS_AND_ARTIFACT_IDENTITIES",
    "PRIVATE_EVIDENCE_MUST_NOT_BE_PUBLISHED_OR_INFERRED_FROM_TRANSPORT_CAPABILITY",
    "HASH_OR_LINEAGE_INTEGRITY_ESTABLISHES_BYTE_OR_PROVENANCE_IDENTITY_NOT_FACTUAL_TRUTH_EXTERNAL_CERTIFICATION_OR_INDEPENDENT_VALIDATION",
    "REFERENCE_ARTIFACTS_MAY_CONSTRAIN_APPROVED_CONSTRUCTION_ONLY_WHEN_SEPARATELY_ADMITTED_AND_BOUND_TO_EXACT_IDENTITY",
    "FAILURE_EVIDENCE_AND_SUPERSEDED_RECEIPTS_MUST_NOT_BE SILENTLY REWRITTEN AS SUCCESS"
  ],
  "requiredInstructions": [
    "AGENTS.md",
    "AI_ENTRYPOINT.json"
  ],
  "registries": [
    ".github/ai-router/router.v1.json"
  ],
  "procedures": {
    "operationAdmission": "CANONICAL_REPOSITORY_OPERATION_INTAKE_REQUIRED_BEFORE_MUTATION",
    "routerCommand": "node tools/repository-ai-entry-router.mjs --path <PATH> [--path <PATH> ...] --task <TASK> [--mutation-intent] --output <OUTSIDE_REPOSITORY_OR_IGNORED_PATH>/public-legitimacy-router-receipt.json",
    "implementationOrder": [
      "CANONICAL_INTAKE_ADMITTED_AND_LOCKED",

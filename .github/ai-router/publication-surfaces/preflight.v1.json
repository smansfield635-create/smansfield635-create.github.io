{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "preflight.v1",
  "description": "Unlisted Preflight first-use inspection: a useful zero-setup check before optional local continuity; transparent rule-based baseline",
  "checks": [
    {
      "path": "/preflight/index.html",
      "includes": [
        "DiamondGate · Preflight",
        "noindex,nofollow,noarchive",
        "./assets/studio.css",
        "./assets/preflight-core.js",
        "./assets/studio.js",
        "id=\"idea\"",
        "id=\"checkBtn\"",
        "id=\"assessmentPanel\"",
        "id=\"prepareBtn\"",
        "id=\"resultPanel\""
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY",
        "ED25519_PRIVATE_KEY"
      ]
    },
    {
      "path": "/preflight/assets/studio.js",
      "includes": [
        "dataset.startup",
        "checkBtn",
        "assessFirstUse",
        "makeFirstRequest",
        "copyBtn",
        "saveBaselineBtn"
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY",
        "ED25519_PRIVATE_KEY"
      ]
    },
    {
      "path": "/preflight/assets/preflight-core.js",
      "includes": [
        "NOT_VERIFIED",
        "DGB_PREFLIGHT_USER_APPROVED_SNAPSHOT_v0_1",
        "assessFirstUse",
        "makeFirstRequest",
        "firstUseIdentity"
      ],
      "excludes": [
        "ED25519_PRIVATE_KEY"
      ]
    },
    {
      "path": "/preflight/assets/studio.css",
      "includes": [
        ".intro",
        ".input-card",
        ".assessment",
        ".questions"
      ],
      "excludes": [
        "javascript:"
      ]
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/preflight/",
    "timeoutMs": 45000,
    "readySelector": "body[data-startup=\"ready\"]",
    "binding": {
      "mode": "direct-document",
      "path": "/preflight/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [],
    "interactions": [
      {
        "name": "First visit uses bakery example with no registration",
        "action": {
          "type": "click",
          "selector": "[data-example=\"video\"]"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#taskLabel",
            "value": "Video / animation"
          },
          {
            "type": "textContains",
            "selector": "#recognizedIdea",
            "value": "20-second commercial for my bakery"
          },
          {
            "type": "textContains",
            "selector": "#questionList",
            "value": "Where will people see it?"
          }
        ]
      },
      {
        "name": "Prepare first request without any approval",
        "action": {
          "type": "click",
          "selector": "#prepareBtn"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#preparedText",
            "value": "MY AI REQUEST"
          },
          {
            "type": "textContains",
            "selector": "#preparedText",
            "value": "QUESTIONS STILL OPEN"
          },
          {
            "type": "textContains",
            "selector": "#preparedText",
            "value": "20-second commercial for my bakery"
          }
        ]
      },
      {
        "name": "Open optional local continuity",
        "action": {
          "type": "click",
          "selector": "#continuityDetails summary"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#saveBaselineBtn"
          }
        ]
      },
      {
        "name": "Explicit save of first-use request",
        "action": {
          "type": "click",
          "selector": "#saveBaselineBtn"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#baselineMessage",
            "value": "Saved on this device"
          }
        ]
      },
      {
        "name": "Different app example gets domain-specific questions",
        "action": {
          "type": "click",
          "selector": "[data-example=\"app\"]"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#taskLabel",
            "value": "App / website"
          },
          {
            "type": "textContains",
            "selector": "#questionList",
            "value": "Does existing data need protection?"
          },
          {
            "type": "textContains",
            "selector": "#revisionText",
            "value": "differs from the version you saved"
          }
        ]
      },
      {
        "name": "Make another request without repeat approval",
        "action": {
          "type": "click",
          "selector": "#prepareBtn"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#preparedText",
            "value": "appointment-booking app"
          },
          {
            "type": "textContains",
            "selector": "#preparedText",
            "value": "CONFIRMED DETAILS"
          }
        ]
      }
    ]
  }
}

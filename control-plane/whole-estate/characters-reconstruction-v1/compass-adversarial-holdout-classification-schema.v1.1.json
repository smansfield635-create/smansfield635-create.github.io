{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "COMPASS_ADVERSARIAL_HOLDOUT_CLASSIFICATION_SCHEMA_v1_1",
  "title": "Compass 16-bearing adversarial holdout classifier submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classifierId", "corpusSha256", "keyAccessedBeforeSubmission", "classifications"],
  "properties": {
    "schema": {"const": "COMPASS_ADVERSARIAL_HOLDOUT_CLASSIFIER_SUBMISSION_v1_1"},
    "classifierId": {"type": "string", "minLength": 1},
    "corpusSha256": {"const": "6b237426c06518daa2fe7e274ae3901af2d450a9131bab0e64cfd8b19fd7df67"},
    "keyAccessedBeforeSubmission": {"const": false},
    "classifications": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "primitiveRequirements", "dominance", "adjacency", "opposition", "decomposition", "bearing", "route", "domain", "authority", "independentReviewBearing", "ambiguity"],
        "properties": {
          "caseId": {"type": "string", "pattern": "^AH(?:0[1-9]|1[0-9]|2[0-8])$"},
          "primitiveRequirements": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["N", "E", "S", "W"]}},
          "dominance": {"type": ["string", "null"]},
          "adjacency": {"type": "boolean"},
          "opposition": {"type": "boolean"},
          "decomposition": {"type": "boolean"},
          "bearing": {"enum": ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW", null]},
          "route": {"type": "array", "items": {"enum": ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]}},
          "domain": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "independentReviewBearing": {"enum": ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW", null]},
          "ambiguity": {"type": "boolean"}
        }
      }
    }
  }
}

{
  "$id": "MECHANISM_DERIVED_REAL_INTERVENTION_PREDICTION_SUBMISSION_SCHEMA_v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "model_id": {
      "minLength": 1,
      "type": "string"
    },
    "operation_id": {
      "const": "MECHANISM_DERIVED_REAL_INTERVENTION_GAUNTLET_v1"
    },
    "public_package_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "submission_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "submitted_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "system_predictions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "boundary": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "episode_predictions": {
            "items": {
              "properties": {
                "affected_capabilities": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "confidence": {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                "endogenous_route_status": {
                  "enum": [
                    "AVAILABLE",
                    "DEGRADED",
                    "UNAVAILABLE",
                    "UNKNOWN"
                  ]
                },
                "episode_id": {
                  "type": "string"
                },
                "hysteresis_class": {
                  "enum": [
                    "RETURNED_TO_REFERENCE",
                    "PATH_DEPENDENT_DIFFERENCE",
                    "NOT_TESTED",
                    "UNKNOWN"
                  ]
                },
                "restoration_status": {
                  "enum": [
                    "NOT_RESTORED",
                    "PARTIAL",
                    "ENDOGENOUS_RESTORED",
                    "LAWFUL_SUBSTITUTE",
                    "UNKNOWN"
                  ]
                },
                "support_mode": {
                  "enum": [
                    "INTRINSIC",
                    "SUPPORTED",
                    "SUBSTITUTED",
                    "MIXED",
                    "NONE",
                    "UNKNOWN"
                  ]
                },
                "test_ids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "unaffected_capabilities": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "episode_id",
                "test_ids",
                "affected_capabilities",
                "unaffected_capabilities",
                "endogenous_route_status",
                "support_mode",
                "restoration_status",
                "hysteresis_class",
                "confidence"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "relations": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "route_families": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "system_id": {
            "type": "string"
          }
        },
        "required": [
          "system_id",
          "boundary",
          "relations",
          "route_families",
          "episode_predictions"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "team_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "team_id",
    "model_id",
    "public_package_sha256",
    "submitted_at_utc",
    "system_predictions",
    "submission_sha256"
  ],
  "type": "object"
}

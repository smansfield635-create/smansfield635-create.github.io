{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "preflight.v1",
  "description": "Original DiamondGate project workspace migration; legacy surfaces retained.",
  "checks": [
    {
      "path": "/preflight/index.html",
      "includes": [
        "DiamondGate \u00b7 Preflight",
        "noindex,nofollow,noarchive",
        "./assets/studio.css",
        "./assets/preflight-core.js",
        "./assets/studio.js",
        "id=\"idea\"",
        "id=\"checkBtn\"",
        "id=\"assessmentPanel\"",
        "id=\"prepareBtn\"",
        "id=\"resultPanel\""
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY",
        "ED25519_PRIVATE_KEY"
      ]
    },
    {
      "path": "/preflight/assets/studio.js",
      "includes": [
        "dataset.startup",
        "checkBtn",
        "assessFirstUse",
        "makeFirstRequest",
        "copyBtn",
        "saveBaselineBtn"
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY",
        "ED25519_PRIVATE_KEY"
      ]
    },
    {
      "path": "/preflight/assets/preflight-core.js",
      "includes": [
        "NOT_VERIFIED",
        "DGB_PREFLIGHT_USER_APPROVED_SNAPSHOT_v0_1",
        "assessFirstUse",
        "makeFirstRequest",
        "firstUseIdentity"
      ],
      "excludes": [
        "ED25519_PRIVATE_KEY"
      ]
    },
    {
      "path": "/preflight/assets/studio.css",
      "includes": [
        ".intro",
        ".input-card",
        ".assessment",
        ".questions"
      ],
      "excludes": [
        "javascript:"
      ]
    },
    {
      "path": "/preflight/saas-lab/index.html",
      "includes": [
        "DiamondGate \u2022 Development Lab",
        "noindex,nofollow,noarchive",
        "./styles.css",
        "./app.mjs",
        "id=\"project-input\"",
        "id=\"report-input\"",
        "id=\"preview\"",
        "id=\"continuation\""
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY",
        "sk-proj-"
      ]
    },
    {
      "path": "/preflight/saas-lab/app.mjs",
      "includes": [
        "receiveResult",
        "describeProgress",
        "generateContinuation",
        "Unassigned evidence",
        "textContent"
      ],
      "excludes": [
        "localStorage",
        "sessionStorage",
        "fetch(",
        "XMLHttpRequest",
        "GITHUB_TOKEN"
      ]
    },
    {
      "path": "/preflight/saas-lab/progression.mjs",
      "includes": [
        "validateState",
        "receiveResult",
        "generateContinuation",
        "milestone"
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY",
        "sk-proj-"
      ]
    },
    {
      "path": "/preflight/saas-lab/fixtures/sample-world-before.json",
      "includes": [
        "SAMPLE_WORLD",
        "CAM-FINAL"
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY"
      ]
    },
    {
      "path": "/preflight/app/index.html",
      "includes": [
        "DiamondGate \u2014 Pick up your work",
        "./dist/style.css",
        "./dist/app.mjs",
        "id=\"projects\"",
        "id=\"backup-file\"",
        "noindex,nofollow,noarchive"
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY",
        "sk-proj-"
      ]
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/preflight/app/",
    "timeoutMs": 45000,
    "readySelector": "#template-preview:not(:empty)",
    "binding": {
      "mode": "direct-document",
      "path": "/preflight/app/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [],
    "interactions": [
      {
        "name": "Original workspace help is interactive",
        "action": {
          "type": "click",
          "selector": "#help"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#help-dialog[open]"
          },
          {
            "type": "textContains",
            "selector": "#help-dialog",
            "value": "local storage"
          }
        ]
      },
      {
        "name": "Return to workspace",
        "action": {
          "type": "click",
          "selector": "#close-help"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#help-dialog:not([open])"
          }
        ]
      },
      {
        "name": "Start-new-work path",
        "action": {
          "type": "key",
          "selector": "#entry-route",
          "key": "Home"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "#review-packet"
          }
        ]
      },
      {
        "name": "Open saved projects",
        "action": {
          "type": "key",
          "selector": "#entry-route",
          "key": "End"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#library-view",
            "value": "My Projects"
          }
        ]
      }
    ]
  }
}

{
  "schema": "REPOSITORY_AI_PROJECT_ENTRYPOINT_v1",
  "projectId": "LAWS",
  "status": "ACTIVE_REGISTERED_PROJECT",
  "ownedPathPrefixes": [
    "laws/"
  ],
  "ownedExactPaths": [
    ".github/workflows/laws-orbital-tranche-a0-a3.yml"
  ],
  "entrypoint": ".github/ai-router/projects/laws/entrypoint.v1.json",
  "authorityBoundary": [
    "ROUTING_DOES_NOT_CREATE_SCIENTIFIC_AUTHORITY",
    "ROUTING_DOES_NOT_AUTHORIZE_MUTATION_WITHOUT_CANONICAL_REPOSITORY_OPERATION_INTAKE",
    "PAGE_OR_INTERFACE_MUTATION_REQUIRES_THE_MANDATORY_PAGE_EXCELLENCE_GATE",
    "PRESENTATION_MAY_RESOLVE_EXISTING_LAWS_AUTHORITY_BUT_MAY_NOT_MANUFACTURE_IT",
    "TESTS_PROJECTION_AND_BATTERY_LINEAGE_REMAIN_OUTSIDE_ROUTER_REGISTRATION_AUTHORITY"
  ],
  "requiredInstructions": [
    "AGENTS.md",
    "AI_ENTRYPOINT.json",
    ".github/ai-router/page-excellence-toolchain/README.md"
  ],
  "registries": [
    ".github/ai-router/router.v1.json",
    ".github/ai-router/shared-procedures.v1.json",
    ".github/ai-router/execution-backends.v1.json"
  ],
  "procedures": {
    "operationAdmission": "CANONICAL_REPOSITORY_OPERATION_INTAKE_REQUIRED_BEFORE_MUTATION",
    "pageOperationGate": ".github/ai-router/page-excellence-toolchain/page-operation-entry-gate.v1.mjs",
    "routerCommand": "node tools/repository-ai-entry-router.mjs --path <PATH> --task <TASK> [--mutation-intent] --output <OUTSIDE_REPOSITORY_OR_IGNORED_PATH>/laws-router-receipt.json",
    "pageMutationOrder": [
      "CANONICAL_INTAKE_ADMITTED_AND_LOCKED",
      "REPOSITORY_AI_ROUTER_PASS",
      "PAGE_EXCELLENCE_REQUIRED_PHASE_PASS",
      "BOUNDED_CONSTRUCTION",
      "REQUIRED_RUNTIME_EVIDENCE",
      "PERCEPTUAL_ACCEPTANCE_REQUEST"
    ]
  },
  "localExecution": {
    "allowed": true,
    "requirements": [
      "FULL_REPOSITORY_CHECKOUT",
      "EXACT_SUBJECT_HEAD",
      "COMMAND_EMITTED_ADMISSION_RECEIPT",
      "ROUTER_RECEIPT_FOR_EVERY_AFFECTED_PATH"
    ]
  },
  "githubActionsExecution": {
    "routerValidationWorkflow": ".github/workflows/repository-ai-entry-router-validation.yml",
    "pageExcellenceRequiredForPageOperations": true
  },
  "stoppingRules": [
    "STOP_IF_CANONICAL_INTAKE_IS_NOT_ADMITTED_AND_LOCKED",
    "STOP_IF_ROUTER_DISPOSITION_IS_BLOCK_OR_STOP",
    "STOP_IF_PAGE_OPERATION_GATE_IS_NOT_PASS",
    "STOP_IF_REQUIRED_RUNTIME_EVIDENCE_IS_MISSING",
    "STOP_IF_PRESENTATION_IS_USED_TO_INFER_SCIENTIFIC_AUTHORITY"
  ]
}

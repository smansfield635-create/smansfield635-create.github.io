{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "research-frontier-seven-object-v1",
  "description": "Seven-object Research Frontier with Meaning and Evidence primary sides, one Shared Bridge, exact return semantics, and bounded evidence-lens inspection.",
  "checks": [
    {
      "path": "/evidence/agentic-frontier/",
      "includes": [
        "Research Frontier — Diamond Gate Bridge",
        "Seven questions at the boundary of what can be claimed.",
        "data-rf-root",
        "data-rf-track",
        "data-rf-open",
        "data-rf-inspector",
        "data-rf-flip",
        "data-rf-open-bridge",
        "The constraint is shared. The evidence is not.",
        "/assets/evidence/research-frontier.v3.css",
        "/assets/evidence/research-frontier.v3.js"
      ],
      "excludes": [
        "Scientific side",
        "Agentic side"
      ]
    },
    {
      "path": "/assets/evidence/research-frontier.v3.js",
      "includes": [
        "RFV3-01",
        "RFV3-02",
        "RFV3-03",
        "RFV3-04",
        "RFV3-05",
        "RFV3-06",
        "RFV3-07",
        "View the Other Side",
        "Inspect Shared Bridge",
        "Return to Orbit",
        "Return to Selected Side",
        "MECHANISM_REPLICATED",
        "NOT_IDENTIFIABLE",
        "PREREGISTERED_NOT_EXECUTED"
      ]
    },
    {
      "path": "/assets/evidence/research-frontier.v3.css",
      "includes": [
        ".rf-orbit-stage",
        ".rf-inspector",
        ".rf-bridge",
        "prefers-reduced-motion"
      ]
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/evidence/agentic-frontier/",
    "readySelector": ".rf-node[data-index=\"6\"]",
    "timeoutMs": 15000,
    "failOnPageErrors": true,
    "failOnConsoleErrors": false,
    "binding": {
      "mode": "direct-document",
      "path": "/evidence/agentic-frontier"
    },
    "interactions": [
      {
        "name": "rotate-to-second-object",
        "action": {
          "type": "key",
          "selector": ".rf-node[aria-selected=\"true\"]",
          "key": "ArrowRight"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": ".rf-node[data-index=\"1\"]",
            "name": "aria-selected",
            "value": "true"
          },
          {
            "type": "textContains",
            "selector": "[data-rf-selected-title]",
            "value": "What Has to Be True First?"
          }
        ]
      },
      {
        "name": "open-selected-meaning-side",
        "action": {
          "type": "click",
          "selector": "[data-rf-open]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "[data-rf-inspector]:not([hidden])"
          },
          {
            "type": "attributeEquals",
            "selector": "[data-rf-panel]",
            "name": "data-side",
            "value": "meaning"
          },
          {
            "type": "textContains",
            "selector": "[data-rf-inspector-id]",
            "value": "RFV3-02"
          }
        ]
      },
      {
        "name": "flip-to-evidence-side",
        "action": {
          "type": "click",
          "selector": "[data-rf-flip]"
        },
        "assertions": [
          {
            "type": "attributeEquals",
            "selector": "[data-rf-panel]",
            "name": "data-side",
            "value": "evidence"
          },
          {
            "type": "exists",
            "selector": "[data-rf-lens-zone]:not([hidden])"
          }
        ]
      },
      {
        "name": "open-shared-bridge",
        "action": {
          "type": "click",
          "selector": "[data-rf-open-bridge]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "[data-rf-bridge]:not([hidden])"
          },
          {
            "type": "textContains",
            "selector": "[data-rf-bridge-relation]",
            "value": "What must be true before comparison is allowed to begin?"
          }
        ]
      },
      {
        "name": "return-to-selected-evidence-side",
        "action": {
          "type": "click",
          "selector": "[data-rf-close-bridge]"
        },
        "assertions": [
          {
            "type": "exists",
            "selector": "[data-rf-bridge][hidden]"
          },
          {
            "type": "attributeEquals",
            "selector": "[data-rf-panel]",
            "name": "data-side",
            "value": "evidence"
          }
        ]
      }
    ]
  }
}

{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "on-your-side-native-chat",
  "description": "On Your Side AAI Native Chat v1 exact-head publication verification. Static checks bind the public parent route, content-addressed Native Chat runtime identity, preserved WebLLM 0.2.85 primary backend, exact wllama 3.6.0 CPU fallback with ordered version-pinned module transport failover, diagnostic v2 stage/failure-chain evidence, first-inference boundary timing, non-destructive first-content watchdog, and WebGPU IndexedDB cache binding, preserved exact wllama 3.6.0 WASM and Qwen GGUF identities, truthful resource disclosure, user-initiated local model loading, and the public/private authority boundary. Runtime verification requires the Native Chat document to boot and remain navigable without model initialization; it does not judge model intelligence or private control-plane capability.",
  "checks": [
    {
      "path": "/products/on-your-side-ai/index.html",
      "includes": [
        "href=\"/products/on-your-side-ai/native-chat/\"",
        "Open Native Chat",
        "Always on your side. Never in control."
      ],
      "excludes": []
    },
    {
      "path": "/products/on-your-side-ai/native-chat/index.html",
      "includes": [
        "<title>Native Chat — On Your Side AAI</title>",
        "Public Talk v1",
        "id=\"chat\"",
        "id=\"load-model\"",
        "Local inference",
        "No repository credentials, private control plane, or execution authority.",
        "The WebGPU path is roughly 294 MB. CPU fallback may require about 398 MB more on its first load.",
        "id=\"diagnostic-details\"",
        "id=\"copy-diagnostic\"",
        "<link rel=\"stylesheet\" href=\"./index.css?v=f499fb6a1fa3d4f05541bcb74447f68db265cb0c\" />",
        "<script type=\"module\" src=\"./index.js?v=dc93288921f01db5729416453a35ee2a454b3fe0\"></script>",
        "data-native-chat-runtime=\"dc93288921f01db5729416453a35ee2a454b3fe0\""
      ],
      "excludes": []
    },
    {
      "path": "/products/on-your-side-ai/native-chat/index.js",
      "includes": [
        "https://esm.run/@mlc-ai/web-llm@0.2.85",
        "./runtime/model/Qwen2.5-0.5B-Instruct-q4f16_1-MLC/",
        "./runtime/webllm/Qwen2-0.5B-Instruct-q4f16_1_cs1k-webgpu.wasm",
        "if (!(\"gpu\" in navigator))",
        "const localEngine = await webllm.CreateMLCEngine(MODEL_ID",
        "els.loadButton.addEventListener(\"click\", loadModel);",
        "engine.interruptGenerate();",
        "Public Talk has no repository execution authority.",
        "https://cdn.jsdelivr.net/npm/@wllama/wllama@3.6.0/esm/index.js",
        "https://unpkg.com/@wllama/wllama@3.6.0/esm/index.js",
        "./runtime/wllama/3.6.0/wllama.wasm",
        "n_ctx: 2048",
        "n_threads: 1",
        "n_gpu_layers: 0",
        "engine = await loadCpuFallback(primaryFailureCode || \"WEBLLM_INITIALIZATION_FAILED\")",
        "activeAbortController?.abort();",
        "new URL(import.meta.url).searchParams.get(\"v\")",
        "RUNTIME_RELEASE_ID !== DECLARED_RUNTIME_RELEASE_ID",
        "NATIVE_CHAT_RUNTIME_RELEASE_ID_MISMATCH",
        "dataset.nativeChatRuntimeActive = RUNTIME_RELEASE_ID",
        "schema: \"NATIVE_CHAT_LOCAL_DIAGNOSTIC_v2\"",
        "JSDELIVR_NPM_EXACT",
        "UNPKG_NPM_EXACT",
        "CPU_MODULE_PROBE",
        "moduleImportAttempts",
        "firstFailedStage",
        "lastPassedStage",
        "failureChain",
        "activeModuleSource",
        "WLLAMA_REQUIRED_EXPORTS_MISSING",
        "CPU_WASM_FETCH",
        "CPU_GGUF_HEAD_PROBE",
        "CPU_GGUF_DOWNLOAD",
        "CPU_MODEL_LOAD",
        "FIRST_INFERENCE",
        "Copy diagnostic report",
        "diagnosticDetails.open = true",
        "FIRST_CONTENT_TOKEN_WATCHDOG_MS = 60_000",
        "INFERENCE_REQUEST_SENT",
        "STREAM_OPENED",
        "FIRST_CHUNK",
        "FIRST_CONTENT_TOKEN_WAIT",
        "FIRST_CONTENT_TOKEN",
        "COMPLETION_END",
        "Diagnostic timing captured; generation is still running.",
        "cacheBackend: \"indexeddb\"",
        "webgpuCacheBackend: \"indexeddb\"",
        "WebGPU cache backend: ${diagnosticState.webgpuCacheBackend}",
        "details: { cacheBackend: appConfig.cacheBackend }"
      ],
      "excludes": [
        "https://esm.run/@wllama/wllama@3.6.0",
        "https://cdn.jsdelivr.net/npm/@wllama/wllama@3.4.0/esm/index.js",
        "https://unpkg.com/@wllama/wllama@3.4.0/esm/index.js",
        "./runtime/wllama/3.4.0/wllama.wasm",
        "cacheBackend: \"cache\""
      ]
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/products/on-your-side-ai/native-chat/",
    "timeoutMs": 15000,
    "readySelector": "#chat",
    "binding": {
      "mode": "direct-document",
      "path": "/products/on-your-side-ai/native-chat/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": []
  }
}

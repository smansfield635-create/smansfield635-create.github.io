    "activationCommand": "node governance/methods-information-benchmark-bootstrap-v1/tools/activation-gate.mjs --builder <BUILDER_RECEIPT> --verifier <VERIFIER_RECEIPT> --comparison <COMPARISON_RECEIPT> --acceptance <USER_ACCEPTANCE_RECEIPT> --output <OUTSIDE_REPOSITORY_OR_IGNORED_PATH>/activation.json",
    "assignmentCommand": "node governance/methods-information-benchmark-bootstrap-v1/tools/role-holder-admission.mjs --ledger <LEDGER_PATH> --expected-head <EXPECTED_LEDGER_HEAD> --role ROLE_6 --holder <EXECUTION_ID> --activation <ACTIVATION_RECEIPT> --output <OUTSIDE_REPOSITORY_OR_IGNORED_PATH>/assignment.json"
  },
  "localExecution": {
    "backendId": "LOCAL_CLEAN_GIT",
    "requiresCleanWorktree": true,
    "runtime": "NODE_22_OR_NEWER"

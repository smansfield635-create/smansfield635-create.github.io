{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SEMANTIC_EVIDENCE_DECISION_PROFILE_v1",
  "title": "Semantic Evidence Decision Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptClass",
    "decisionId",
    "resolverIdentity",
    "contextBinding",
    "relation",
    "authority",
    "sourceIdentities",
    "provenancePointers",
    "qualifiers",
    "failureReasons",
    "inputDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "SEMANTIC_EVIDENCE_DECISION_PROFILE_v1"
    },
    "receiptClass": {
      "const": "SEMANTIC_RELATION_DECISION"
    },
    "decisionId": {
      "type": "string",
      "minLength": 1
    },
    "resolverIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "contextBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextId",
        "contextRevision"
      ],
      "properties": {
        "contextId": {
          "type": "string",
          "minLength": 1
        },
        "contextRevision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationId",
        "relationType",
        "fromObjectIdentity",
        "toObjectIdentity",
        "resolutionState",
        "edgeEligible"
      ],
      "properties": {
        "relationId": {
          "type": "string",
          "minLength": 1
        },
        "relationType": {
          "type": "string",
          "minLength": 1
        },
        "fromObjectIdentity": {
          "type": "string",
          "minLength": 1
        },
        "toObjectIdentity": {
          "type": "string",
          "minLength": 1
        },
        "resolutionState": {
          "enum": [
            "ASSERTED",
            "NONE",
            "UNKNOWN",
            "UNEVALUABLE",
            "CONFLICTED"
          ]
        },
        "edgeEligible": {
          "type": "boolean"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityId",
        "authorityVersion",
        "standing",
        "claimCeiling"
      ],
      "properties": {
        "authorityId": {
          "type": "string",
          "minLength": 1
        },
        "authorityVersion": {
          "type": "string",
          "minLength": 1
        },
        "standing": {
          "type": "string",
          "minLength": 1
        },
        "claimCeiling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceIdentities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "provenancePointers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "qualifiers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "failureReasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

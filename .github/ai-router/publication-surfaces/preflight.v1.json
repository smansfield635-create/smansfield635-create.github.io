{
  "schema": "PUBLICATION_SURFACE_VERIFICATION_v1",
  "surfaceId": "preflight.v1",
  "description": "Unlisted DiamondGate Preflight native web interface for owner inspection; no private kernel source and no publication authority created",
  "checks": [
    {
      "path": "/preflight/index.html",
      "includes": [
        "DiamondGate · Preflight Studio",
        "noindex,nofollow,noarchive",
        "./assets/studio.css",
        "./assets/preflight-core.js",
        "./assets/studio.js",
        "id=\"goal\"",
        "id=\"approveBtn\""
      ],
      "excludes": [
        "github.com/smansfield635-create/geodiametrics1",
        ".github/ai-router/canonical-control-kernel-v1"
      ]
    },
    {
      "path": "/preflight/assets/studio.js",
      "includes": [
        "dataset.startup",
        "approveBtn",
        "prepareBtn"
      ],
      "excludes": [
        "GITHUB_TOKEN",
        "PRIVATE_KEY"
      ]
    },
    {
      "path": "/preflight/assets/preflight-core.js",
      "includes": [
        "NOT_VERIFIED",
        "DGB_PREFLIGHT_USER_APPROVED_SNAPSHOT_v0_1"
      ],
      "excludes": [
        "ED25519_PRIVATE_KEY"
      ]
    },
    {
      "path": "/preflight/assets/studio.css",
      "includes": [
        ".hero",
        ".studio-layout"
      ],
      "excludes": [
        "javascript:"
      ]
    }
  ],
  "runtime": {
    "enabled": true,
    "path": "/preflight/",
    "timeoutMs": 45000,
    "readySelector": "body[data-startup=\"ready\"]",
    "binding": {
      "mode": "direct-document",
      "path": "/preflight/"
    },
    "failOnConsoleErrors": true,
    "failOnPageErrors": true,
    "ignoreConsoleErrorIncludes": [],
    "interactions": [
      {
        "name": "Switch to software app example",
        "action": {
          "type": "click",
          "selector": "[data-preset=\"app\"]"
        },
        "assertions": [
          {
            "type": "textContains",
            "selector": "#protectedList",
            "value": "Existing user data must not be deleted."
          }
        ]
      }
    ]
  }
}
